public fn format_double(value: f64, signed_nan: Bool, out: &[u8]) -> length: u64 writes(out) contract {
  requires out^.len >= 32_u64;
  ensures length <= 32_u64;
} doc "Writes value as fpconv_dtoa writes it into the first returned length bytes of out, without a NUL terminator: a minus sign when the sign bit is set, then 0 for either zero, inf for an infinity, nan for a NaN, or otherwise the digits of Grisu2 with no exact fallback, which read back exactly but are not always the shortest that do (1e23 is 99999999999999990000000). With K the power of ten of the last digit and E that of the first, the digits are written as an integer followed by K zeros when K is 0 to 7; as a decimal with a point, or 0. and leading zeros, when K is negative and above -7 or E is between -3 and 3; and otherwise as one digit, a point and the rest, then e+ or e- and E's digits with no padding (1e+100, 1e-7). signed_nan true writes a negative NaN's sign as fpconv_dtoa does (-nan); false writes every NaN as nan.";
