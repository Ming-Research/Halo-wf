alias Value = pkg::value::Value;
alias Cell = pkg::value::Cell;
alias Program = pkg::value::Program;
alias Bases = pkg::value::Bases;
alias CompileError = pkg::compile::CompileError;
alias Outcome = pkg::vm::Outcome;
alias Host = pkg::vm::Host;
alias PendingCall = pkg::execution::PendingCall;
alias CollectionStats = pkg::heap::CollectionStats;

fn append_value(out: &Box<Slots<Value>>, value: Value) -> r: unit writes(out) {
  let n = out^.inner.len;
  if n < 18446744073709551615_u64 {
    if n == out^.inner.cap {
      let twice = n +sat n;
      let cap = imax(twice, 16_u64);
      grow(cell: out, capacity: cap);
    }
    if out^.inner.len < out^.inner.cap {
      place_back(window: &out^.inner, value: value);
    }
  }
  return unit;
}

fn invalidate_roots(engine: &Engine) -> r: unit writes(engine.roots_valid) {
  set engine^.roots_valid = False();
  return unit;
}

fn refresh_roots(engine: &Engine) -> r: unit writes(engine) {
  doc "The program keeps one root bridge in its constant-pool tail until compile, pin or unpin invalidates it. Only the original constants, those of every installed script, source a rebuild; the tail is never read during one.";
  if engine^.roots_valid {
    return unit;
  }
  loop {
    if engine^.program.consts.inner.len > engine^.constant_length {
      let dropped = take_back(window: &engine^.program.consts.inner);
    } else {
      break;
    }
  }
  for (i in 0_u64..engine^.pins.inner.len) {
    let v = engine^.pins.inner[i];
    append_value(out: &engine^.program.consts, value: v);
  }
  set engine^.roots_valid = True();
  return unit;
}

fn new_engine(limit: u64) -> r: Engine pure {
  let vm = pkg::vm::vm_new(limit: limit);
  let stack = pkg::vm::stack_new(size: 256_u64);
  let code = box_slots_new::<Cell>(capacity: 0_u64);
  let consts = box_slots_new::<Value>(capacity: 0_u64);
  let program = Program(code: move code, consts: move consts);
  let entries = box_slots_new::<u32>(capacity: 0_u64);
  let pins = box_slots_new::<Value>(capacity: 0_u64);
  let active = None<ScriptId>();
  let no = False();
  let engine = Engine(vm: move vm, stack: move stack, program: move program, entries: move entries, constant_length: 0_u64, pins: move pins, roots_valid: no, generation: 0_u64, active: active, result_count: 0_u64, resumable: no, calling: no);
  install_core(engine: &engine);
  pkg::vm::install_libraries(vm: &engine.vm);
  return move engine;
}

const cache_error: Array<u8, 22> = "script cache exhausted";

fn cache_failure() -> r: Result<ScriptId, CompileError> pure {
  let message = box_slots_new::<u8>(capacity: 22_u64);
  for (i in 0_u64..22_u64) {
    if message.inner.len < message.inner.cap {
      let b = cache_error[i];
      place_back(window: &message.inner, value: b);
    }
  }
  let error = CompileError(line: 0_u64, message: move message);
  return Err<ScriptId, CompileError>(error: move error);
}

fn compile(engine: &Engine, chunk_name: &[u8], source: &[u8]) -> r: Result<ScriptId, CompileError> reads(chunk_name), reads(source), writes(engine) {
  doc "Compiles a chunk and appends it to the engine's program, where its code, constants and prototype numbers stay for every later run. The program changes only when the compiler accepts the chunk.";
  if engine^.generation == 18446744073709551615_u64 {
    return cache_failure();
  }
  let at = pkg::vm::bases(program: &engine^.program, vm: &engine^.vm);
  if at.protos > 4000000000_u32 {
    return cache_failure();
  }
  let bases = Bases(code: at.code, consts: engine^.constant_length, protos: at.protos, debug: at.debug, locals: at.locals, upvalues: at.upvalues);
  let compiled = pkg::compile::compile(heap: &engine^.vm.heap, chunk_name: chunk_name, source: source, bases: bases);
  match move compiled {
    Err(error: problem) => {
      return Err<ScriptId, CompileError>(error: move problem);
    }
    Ok(value: script) => {
      let n = engine^.entries.inner.len;
      if n < 18446744073709551615_u64 {
        let wanted = n + 1_u64;
        if wanted > engine^.entries.inner.cap {
          let doubled = engine^.entries.inner.cap +sat engine^.entries.inner.cap;
          grow(cell: &engine^.entries, capacity: imax(wanted, doubled));
        }
        if engine^.entries.inner.len < engine^.entries.inner.cap {
          loop {
            if engine^.program.consts.inner.len > engine^.constant_length {
              let dropped = take_back(window: &engine^.program.consts.inner);
            } else {
              break;
            }
          }
          let entry = pkg::vm::install(program: &engine^.program, vm: &engine^.vm, script: &script);
          place_back(window: &engine^.entries.inner, value: entry);
          set engine^.constant_length = engine^.program.consts.inner.len;
          invalidate_roots(engine: engine);
          let id = ScriptId(slot: n, generation: engine^.generation);
          return Ok<ScriptId, CompileError>(value: id);
        }
      }
    }
  }
  return cache_failure();
}

fn reset(engine: &Engine) -> r: unit writes(engine) {
  pkg::vm::reset(vm: &engine^.vm, stack: &engine^.stack);
  for (i in 0_u64..engine^.stack.inner.len) {
    let nil = Value::Nil();
    set engine^.stack.inner[i] = nil;
  }
  set engine^.active = None<ScriptId>();
  set engine^.result_count = 0_u64;
  set engine^.resumable = False();
  set engine^.calling = False();
  return unit;
}

fn forget_all(engine: &Engine) -> r: unit writes(engine) {
  doc "Frees every compiled script. The prototype numbers they held are never reused, so a Lua function kept from before raises an error when called.";
  reset(engine: engine);
  pkg::vm::clear_program(program: &engine^.program, vm: &engine^.vm);
  let entries = box_slots_new::<u32>(capacity: 0_u64);
  set engine^.entries = move entries;
  set engine^.constant_length = 0_u64;
  invalidate_roots(engine: engine);
  set engine^.generation = engine^.generation +sat 1_u64;
  return unit;
}

fn record(engine: &Engine, outcome: Outcome) -> r: Outcome writes(engine.result_count), writes(engine.resumable), writes(engine.calling) {
  set engine^.result_count = 0_u64;
  set engine^.resumable = False();
  set engine^.calling = False();
  match outcome {
    Done(count: n) => {
      set engine^.result_count = n;
    }
    Error() => {
    }
    Budget() => {
      set engine^.resumable = True();
    }
    HostStopped() => {
    }
    HostCall() => {
      set engine^.calling = True();
    }
  }
  return outcome;
}

fn invalid(engine: &Engine) -> r: Outcome writes(engine) {
  let e = intern(engine: engine, bytes: &invalid_script[0_u64..26_u64]);
  set engine^.vm.error = e;
  set engine^.vm.raise_pc = 0_u64;
  set engine^.result_count = 0_u64;
  set engine^.resumable = False();
  set engine^.calling = False();
  return Outcome::Error();
}

const invalid_script: Array<u8, 26> = "invalid or inactive script";

fn start<interface Host<E>>(engine: &Engine, env: &E, script: ScriptId, budget: u64) -> r: Outcome writes(engine), writes(env) {
  reset(engine: engine);
  let s = script.slot;
  if script.generation == engine^.generation {
    refresh_roots(engine: engine);
    if s < engine^.entries.inner.len {
      set engine^.active = Some<ScriptId>(value: script);
      let entry = engine^.entries.inner[s];
      let out = pkg::vm::start::<Host<E>>(program: &engine^.program, stack: &engine^.stack, vm: &engine^.vm, env: env, proto: entry, argc: 0_u64, budget: budget);
      return record(engine: engine, outcome: out);
    }
  }
  return invalid(engine: engine);
}

fn resume<interface Host<E>>(engine: &Engine, env: &E, budget: u64) -> r: Outcome writes(engine), writes(env) {
  if engine^.resumable {
    let active = engine^.active;
    match active {
      None() => {
      }
      Some(value: id) => {
        if id.generation == engine^.generation {
          refresh_roots(engine: engine);
          let out = pkg::vm::resume::<Host<E>>(program: &engine^.program, stack: &engine^.stack, vm: &engine^.vm, env: env, budget: budget);
          return record(engine: engine, outcome: out);
        }
      }
    }
  }
  return invalid(engine: engine);
}

fn pending_call(engine: &Engine) -> r: Option<PendingCall> reads(engine) {
  if engine^.calling {
    let call = engine^.vm.pending;
    return Some<PendingCall>(value: call);
  }
  return None<PendingCall>();
}

fn pending_argument(engine: &Engine, index: u64) -> r: Value reads(engine) {
  if engine^.calling {
    return pkg::vm::pending_argument(vm: &engine^.vm, stack: &engine^.stack, index: index);
  }
  return Value::Nil();
}

fn complete_call<interface Host<E>>(engine: &Engine, env: &E, results: &[Value], budget: u64) -> r: Outcome reads(results), writes(engine), writes(env) {
  if engine^.calling {
    let active = engine^.active;
    match active {
      None() => {
      }
      Some(value: id) => {
        if id.generation == engine^.generation {
          refresh_roots(engine: engine);
          let out = pkg::vm::complete_call::<Host<E>>(program: &engine^.program, stack: &engine^.stack, vm: &engine^.vm, env: env, results: results, budget: budget);
          return record(engine: engine, outcome: out);
        }
      }
    }
  }
  return invalid(engine: engine);
}

fn fail_call<interface Host<E>>(engine: &Engine, env: &E, error: Value, budget: u64) -> r: Outcome writes(engine), writes(env) {
  if engine^.calling {
    let active = engine^.active;
    match active {
      None() => {
      }
      Some(value: id) => {
        if id.generation == engine^.generation {
          refresh_roots(engine: engine);
          let out = pkg::vm::fail_call::<Host<E>>(program: &engine^.program, stack: &engine^.stack, vm: &engine^.vm, env: env, error: error, budget: budget);
          return record(engine: engine, outcome: out);
        }
      }
    }
  }
  return invalid(engine: engine);
}

fn error_line(engine: &Engine) -> r: u64 reads(engine) {
  let at = engine^.vm.raise_pc;
  if at > 0_u64 {
    let pc = at - 1_u64;
    if pc < engine^.vm.lineinfo.inner.len {
      return cvt::<u32, u64>(engine^.vm.lineinfo.inner[pc]);
    }
  }
  return 0_u64;
}

fn result(engine: &Engine, index: u64) -> r: Option<Value> reads(engine) {
  if index < engine^.result_count {
    if index < engine^.stack.inner.len {
      let v = engine^.stack.inner[index];
      return Some<Value>(value: v);
    }
  }
  return None<Value>();
}

fn pin(engine: &Engine, value: Value) -> r: Option<u64> writes(engine) {
  let n = engine^.pins.inner.len;
  if n < 18446744073709551615_u64 {
    append_value(out: &engine^.pins, value: value);
    if n < engine^.pins.inner.len {
      invalidate_roots(engine: engine);
      return Some<u64>(value: n);
    }
  }
  return None<u64>();
}

fn unpin(engine: &Engine, token: u64) -> r: unit writes(engine) {
  if token < engine^.pins.inner.len {
    set engine^.pins.inner[token] = Value::Nil();
    invalidate_roots(engine: engine);
  }
  return unit;
}

fn set_pcall_error_field(engine: &Engine, field: &[u8]) -> r: unit reads(field), writes(engine.vm.pcall_field) {
  let name = box_slots_new::<u8>(capacity: field^.len);
  for (i in 0_u64..field^.len) {
    if name.inner.len < name.inner.cap {
      let b = field^[i];
      place_back(window: &name.inner, value: b);
    }
  }
  set engine^.vm.pcall_field = move name;
  return unit;
}

fn set_gc_stress(engine: &Engine, enabled: Bool) -> r: unit writes(engine.vm.heap.gc_stress) {
  set engine^.vm.heap.gc_stress = enabled;
  return unit;
}

fn collect_at_next_safepoint(engine: &Engine) -> r: unit writes(engine.vm.heap.threshold), writes(engine.vm.heap.bytes_since_gc) {
  doc "Sets the trigger's threshold below the bytes allocated since the last collection; the collection's sweep resets both.";
  set engine^.vm.heap.threshold = 0_u64;
  set engine^.vm.heap.bytes_since_gc = imax(engine^.vm.heap.bytes_since_gc, 1_u64);
  return unit;
}

fn collection_count(engine: &Engine) -> r: u64 reads(engine.vm.heap.collections) {
  return engine^.vm.heap.collections;
}

fn heap_bytes(engine: &Engine) -> r: u64 reads(engine.vm.heap.bytes) {
  return engine^.vm.heap.bytes;
}

fn set_gc_pause(engine: &Engine, percent: u64) -> r: unit writes(engine.vm.heap.gc_pause) {
  doc "Clamps the pause to at least 100 percent; the next completed collection applies it without changing stress or limit behavior.";
  set engine^.vm.heap.gc_pause = imax(percent, 100_u64);
  return unit;
}

fn last_collection(engine: &Engine) -> r: CollectionStats reads(engine.vm.heap.last_collection) {
  doc "Copies the most recent completed collection snapshot without exposing mutable collector storage.";
  return engine^.vm.heap.last_collection;
}
