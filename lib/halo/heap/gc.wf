alias Value = pkg::value::Value;
alias Execution = pkg::execution::Execution;

fn gc_begin(heap: &Heap) -> r: unit writes(heap.epoch), writes(heap.gray_pops) {
  doc "A mark equal to the epoch means reached in this collection; new cells carry mark zero, which no epoch takes.";
  set heap^.gray_pops = 0_u64;
  if heap^.epoch == 4294967295_u32 {
    set heap^.epoch = 1_u32;
  } else {
    set heap^.epoch = heap^.epoch + 1_u32;
  }
  return unit;
}

fn gray_push(heap: &Heap, v: Value) -> r: unit writes(heap.gray) {
  doc "Pushes onto the gray stack, doubling its capacity when full.";
  let n = heap^.gray.inner.len;
  if n >= heap^.gray.inner.cap {
    let capacity = 64_u64;
    if n >= 64_u64 {
      if n <= 9223372036854775807_u64 {
        set capacity = n * 2_u64;
      } else {
        return unit;
      }
    }
    if capacity >= heap^.gray.inner.cap {
      grow(cell: &heap^.gray, capacity: capacity);
    }
  }
  if heap^.gray.inner.len < heap^.gray.inner.cap {
    place_back(window: &heap^.gray.inner, value: v);
  }
  return unit;
}

fn gc_mark(heap: &Heap, v: Value) -> r: unit writes(heap) {
  doc "Strings have no references; tables, closures and threads are gray until propagated.";
  let epoch = heap^.epoch;
  match v {
    Str(h: hv) => {
      let i = cvt::<u32, u64>(hv);
      if i < heap^.strings.inner.len {
        if heap^.strings.inner[i].live {
          set heap^.strings.inner[i].mark = epoch;
        }
      }
    }
    Tab(h: hv) => {
      let i = cvt::<u32, u64>(hv);
      if i < heap^.tables.inner.len {
        if heap^.tables.inner[i].live {
          if heap^.tables.inner[i].mark != epoch {
            set heap^.tables.inner[i].mark = epoch;
            gray_push(heap: heap, v: v);
          }
        }
      }
    }
    Fun(h: hv) => {
      let i = cvt::<u32, u64>(hv);
      if i < heap^.closures.inner.len {
        if heap^.closures.inner[i].live {
          if heap^.closures.inner[i].mark != epoch {
            set heap^.closures.inner[i].mark = epoch;
            gray_push(heap: heap, v: v);
          }
        }
      }
    }
    Thread(h: hv) => {
      let i = cvt::<u32, u64>(hv);
      if i < heap^.threads.inner.len {
        if heap^.threads.inner[i].live {
          if heap^.threads.inner[i].mark != epoch {
            set heap^.threads.inner[i].mark = epoch;
            gray_push(heap: heap, v: v);
          }
        }
      }
    }
    Nil() => {
    }
    False() => {
    }
    True() => {
    }
    Num(n: x) => {
    }
    Builtin(id: bid) => {
    }
  }
  return unit;
}

fn gc_mark_upvalue(heap: &Heap, h: u32) -> r: unit writes(heap) {
  doc "An escaped open capture retains only its captured value, not its owner or unrelated stack slots. A collection parks the installed execution in its cell, so its captures are read here like any other owner's.";
  let epoch = heap^.epoch;
  let i = cvt::<u32, u64>(h);
  if i < heap^.upvalues.inner.len {
    if heap^.upvalues.inner[i].live {
      if heap^.upvalues.inner[i].mark != epoch {
        set heap^.upvalues.inner[i].mark = epoch;
        let u = heap^.upvalues.inner[i].payload;
        match u {
          Closed(v: held) => {
            gc_mark(heap: heap, v: held);
          }
          Open(owner: capture_owner, slot: capture_slot) => {
            let captured = thread_slot(heap: heap, owner: capture_owner, slot: capture_slot);
            gc_mark(heap: heap, v: captured);
          }
        }
      }
    }
  }
  return unit;
}

fn mark_table_contents(heap: &Heap, ti: u64) -> r: unit writes(heap) {
  doc "Marks a table's array values, node keys and values, and metatable; bounds are re-read after every mark, which writes the heap.";
  let j = 0_u64;
  loop {
    if ti < heap^.tables.inner.len {
      if j < heap^.tables.inner[ti].payload.array.inner.len {
        let v = heap^.tables.inner[ti].payload.array.inner[j];
        gc_mark(heap: heap, v: v);
        set j = j +wrap 1_u64;
      } else {
        break;
      }
    } else {
      return unit;
    }
  }
  let k = 0_u64;
  loop {
    if ti < heap^.tables.inner.len {
      if k < heap^.tables.inner[ti].payload.nodes.inner.len {
        let key = heap^.tables.inner[ti].payload.nodes.inner[k].key;
        let val = heap^.tables.inner[ti].payload.nodes.inner[k].val;
        gc_mark(heap: heap, v: key);
        gc_mark(heap: heap, v: val);
        set k = k +wrap 1_u64;
      } else {
        break;
      }
    } else {
      return unit;
    }
  }
  if ti < heap^.tables.inner.len {
    let meta = heap^.tables.inner[ti].payload.meta;
    if meta != no_handle {
      let mv = Value::Tab(h: meta);
      gc_mark(heap: heap, v: mv);
    }
  }
  return unit;
}

fn mark_closure_contents(heap: &Heap, ci: u64) -> r: unit writes(heap) {
  doc "Marks every upvalue a closure captured.";
  let j = 0_u64;
  loop {
    if ci < heap^.closures.inner.len {
      if j < heap^.closures.inner[ci].payload.upvals.inner.len {
        let u = heap^.closures.inner[ci].payload.upvals.inner[j];
        gc_mark_upvalue(heap: heap, h: u);
        set j = j +wrap 1_u64;
      } else {
        return unit;
      }
    } else {
      return unit;
    }
  }
}

fn thread_stack_limit(execution: &Execution) -> r: u64 reads(execution) {
  doc "Retains dynamic results and every frame's registers, capped at stack length; without frames the entire stored stack remains live.";
  let len = execution^.stack.inner.len;
  if execution^.frames.inner.len == 0_u64 {
    return len;
  }
  let limit = execution^.top;
  let i = 0_u64;
  loop {
    if i < execution^.frames.inner.len {
      let top = execution^.frames.inner[i].frame_top;
      if top > limit {
        set limit = top;
      }
      set i = i +wrap 1_u64;
    } else {
      break;
    }
  }
  if execution^.transfer_kind != 0_u8 {
    let transfer_first = execution^.transfer.func +sat 1_u64;
    let transfer_extent = transfer_first +sat execution^.transfer.argc;
    if transfer_extent > limit {
      set limit = transfer_extent;
    }
  }
  return imin(limit, len);
}

fn mark_thread_contents(heap: &Heap, ti: u64) -> r: unit writes(heap) {
  doc "Traces only a reached thread's owned execution; rechecks slab and buffer bounds after marking writes the heap.";
  if ti < heap^.threads.inner.len {
    let entry_value = heap^.threads.inner[ti].entry_function;
    let resumer_handle = heap^.threads.inner[ti].resumer;
    let resumer_value = Value::Thread(h: resumer_handle);
    gc_mark(heap: heap, v: entry_value);
    gc_mark(heap: heap, v: resumer_value);
  }
  if ti < heap^.threads.inner.len {
    if heap^.threads.inner[ti].payload.transfer_kind == 1_u8 {
      let transfer_handle = heap^.threads.inner[ti].payload.transfer.child;
      let transfer_child = Value::Thread(h: transfer_handle);
      gc_mark(heap: heap, v: transfer_child);
    }
  }
  if ti < heap^.threads.inner.len {
    let limit = thread_stack_limit(execution: &heap^.threads.inner[ti].payload);
    for (i in 0_u64..limit) {
      if ti < heap^.threads.inner.len {
        if i < heap^.threads.inner[ti].payload.stack.inner.len {
          let stack_value = heap^.threads.inner[ti].payload.stack.inner[i];
          gc_mark(heap: heap, v: stack_value);
        }
      }
    }
  }
  let i = 0_u64;
  loop {
    if ti < heap^.threads.inner.len {
      if i < heap^.threads.inner[ti].payload.frames.inner.len {
        let closure = heap^.threads.inner[ti].payload.frames.inner[i].closure;
        if closure != no_handle {
          let frame_function = Value::Fun(h: closure);
          gc_mark(heap: heap, v: frame_function);
        }
        set i = i +wrap 1_u64;
      } else {
        break;
      }
    } else {
      return unit;
    }
  }
  set i = 0_u64;
  loop {
    if ti < heap^.threads.inner.len {
      if i < heap^.threads.inner[ti].payload.open_upvalues.inner.len {
        let upvalue = heap^.threads.inner[ti].payload.open_upvalues.inner[i];
        gc_mark_upvalue(heap: heap, h: upvalue);
        set i = i +wrap 1_u64;
      } else {
        break;
      }
    } else {
      return unit;
    }
  }
  set i = 0_u64;
  loop {
    if ti < heap^.threads.inner.len {
      if i < heap^.threads.inner[ti].payload.library_contexts.inner.len {
        let context = heap^.threads.inner[ti].payload.library_contexts.inner[i];
        gc_mark(heap: heap, v: context.table);
        gc_mark(heap: heap, v: context.comparator);
        gc_mark(heap: heap, v: context.saved_error);
        gc_mark(heap: heap, v: context.foreach_key);
        if context.frame.closure != no_handle {
          let library_function = Value::Fun(h: context.frame.closure);
          gc_mark(heap: heap, v: library_function);
        }
        set i = i +wrap 1_u64;
      } else {
        break;
      }
    } else {
      return unit;
    }
  }
  set i = 0_u64;
  loop {
    if ti < heap^.threads.inner.len {
      if i < heap^.threads.inner[ti].payload.sort_frames.inner.len {
        let frame = heap^.threads.inner[ti].payload.sort_frames.inner[i];
        gc_mark(heap: heap, v: frame.a);
        gc_mark(heap: heap, v: frame.b);
        gc_mark(heap: heap, v: frame.pivot);
        set i = i +wrap 1_u64;
      } else {
        break;
      }
    } else {
      return unit;
    }
  }
  set i = 0_u64;
  loop {
    if ti < heap^.threads.inner.len {
      if i < heap^.threads.inner[ti].payload.pattern_subs.inner.len {
        let source = heap^.threads.inner[ti].payload.pattern_subs.inner[i].source;
        let pattern = heap^.threads.inner[ti].payload.pattern_subs.inner[i].pattern;
        let replacement = heap^.threads.inner[ti].payload.pattern_subs.inner[i].replacement;
        gc_mark(heap: heap, v: source);
        gc_mark(heap: heap, v: pattern);
        gc_mark(heap: heap, v: replacement);
        set i = i +wrap 1_u64;
      } else {
        break;
      }
    } else {
      return unit;
    }
  }
  if ti < heap^.threads.inner.len {
    let error = heap^.threads.inner[ti].payload.error;
    gc_mark(heap: heap, v: error);
  }
  set i = 0_u64;
  loop {
    if ti < heap^.threads.inner.len {
      if i < heap^.threads.inner[ti].payload.stopped_stack.inner.len {
        let stopped_value = heap^.threads.inner[ti].payload.stopped_stack.inner[i];
        gc_mark(heap: heap, v: stopped_value);
        set i = i +wrap 1_u64;
      } else {
        return unit;
      }
    } else {
      return unit;
    }
  }
}

fn gc_propagate(heap: &Heap) -> r: unit writes(heap) {
  doc "Empties the gray stack; each object is pushed at most once per epoch, so the work is proportional to what is reachable.";
  loop {
    if heap^.gray.inner.len > 0_u64 {
      let v = take_back(window: &heap^.gray.inner);
      set heap^.gray_pops = heap^.gray_pops +sat 1_u64;
      match v {
        Tab(h: hv) => {
          let ti = cvt::<u32, u64>(hv);
          mark_table_contents(heap: heap, ti: ti);
        }
        Fun(h: hv) => {
          let ci = cvt::<u32, u64>(hv);
          mark_closure_contents(heap: heap, ci: ci);
        }
        Thread(h: hv) => {
          let ti = cvt::<u32, u64>(hv);
          mark_thread_contents(heap: heap, ti: ti);
        }
        Nil() => {
        }
        False() => {
        }
        True() => {
        }
        Num(n: x) => {
        }
        Str(h: hv) => {
        }
        Builtin(id: bid) => {
        }
      }
    } else {
      return unit;
    }
  }
}

fn collection_kind_empty() -> r: CollectionKindStats pure {
  doc "Zero counters for one kind before scanning its slab.";
  return CollectionKindStats(live_objects: 0_u64, live_bytes: 0_u64, freed_objects: 0_u64, freed_bytes: 0_u64, slots_visited: 0_u64);
}

fn collection_stats_empty() -> r: CollectionStats pure {
  doc "No completed collection yet, including no next-collection threshold observation.";
  let empty = collection_kind_empty();
  return CollectionStats(strings: empty, tables: empty, closures: empty, upvalues: empty, threads: empty, gray_pops: 0_u64, next_threshold: 0_u64);
}

fn collection_threshold(live: u64, pause: u64) -> r: u64 pure {
  doc "Computes floor(live * max(pause - 100, 0) / 100) with saturation only on the final mathematical result, then applies the 64 KiB collection floor. Splitting both operands avoids premature product saturation and preserves pause 200 exactly.";
  let growth = pause -sat 100_u64;
  let whole = growth / 100_u64;
  let fraction = growth % 100_u64;
  let hundreds = live / 100_u64;
  let remainder = live % 100_u64;
  let integral = live *sat whole;
  let fractional_hundreds = hundreds *sat fraction;
  let fractional_tail = remainder *sat fraction;
  let tail = fractional_tail / 100_u64;
  let subtotal = integral +sat fractional_hundreds;
  let total = subtotal +sat tail;
  return imax(total, collection_floor);
}

fn gc_sweep(heap: &Heap) -> r: u64 writes(heap) {
  doc "Closes dead owners' captures before freeing any slab payload, so escaped captures cannot retain open references into freed or reused storage. Counts each visited slot and each live or freed payload, then publishes a completed snapshot; free_string also removes the weak intern entry.";
  let epoch = heap^.epoch;
  let ti = 0_u64;
  loop {
    if ti < heap^.threads.inner.len {
      if heap^.threads.inner[ti].live {
        if heap^.threads.inner[ti].mark != epoch {
          if ti < 4294967296_u64 {
            let owner = cvt::<u64, u32>(ti);
            close_thread_upvalues(heap: heap, h: owner);
          }
        }
      }
      set ti = ti +wrap 1_u64;
    } else {
      break;
    }
  }
  let freed = 0_u64;
  let tables = collection_kind_empty();
  let closures = collection_kind_empty();
  let upvalues = collection_kind_empty();
  let strings = collection_kind_empty();
  let threads = collection_kind_empty();
  let i = 0_u64;
  loop {
    if i < heap^.tables.inner.len {
      set tables.slots_visited = tables.slots_visited +sat 1_u64;
      if heap^.tables.inner[i].live {
        let amount = table_bytes(array: heap^.tables.inner[i].payload.array.inner.cap, nodes: heap^.tables.inner[i].payload.nodes.inner.cap);
        let retained = True();
        if heap^.tables.inner[i].mark != epoch {
          if i < 4294967296_u64 {
            let h = cvt::<u64, u32>(i);
            free_table(heap: heap, h: h);
            set freed = freed +wrap 1_u64;
            set tables.freed_objects = tables.freed_objects +sat 1_u64;
            set tables.freed_bytes = tables.freed_bytes +sat amount;
            set retained = False();
          }
        }
        if retained {
          set tables.live_objects = tables.live_objects +sat 1_u64;
          set tables.live_bytes = tables.live_bytes +sat amount;
        }
      }
      set i = i +wrap 1_u64;
    } else {
      break;
    }
  }
  set i = 0_u64;
  loop {
    if i < heap^.closures.inner.len {
      set closures.slots_visited = closures.slots_visited +sat 1_u64;
      if heap^.closures.inner[i].live {
        let tail = 4_u64 *sat heap^.closures.inner[i].payload.upvals.inner.cap;
        let amount = 24_u64 +sat tail;
        let retained = True();
        if heap^.closures.inner[i].mark != epoch {
          if i < 4294967296_u64 {
            let h = cvt::<u64, u32>(i);
            free_closure(heap: heap, h: h);
            set freed = freed +wrap 1_u64;
            set closures.freed_objects = closures.freed_objects +sat 1_u64;
            set closures.freed_bytes = closures.freed_bytes +sat amount;
            set retained = False();
          }
        }
        if retained {
          set closures.live_objects = closures.live_objects +sat 1_u64;
          set closures.live_bytes = closures.live_bytes +sat amount;
        }
      }
      set i = i +wrap 1_u64;
    } else {
      break;
    }
  }
  set i = 0_u64;
  loop {
    if i < heap^.upvalues.inner.len {
      set upvalues.slots_visited = upvalues.slots_visited +sat 1_u64;
      if heap^.upvalues.inner[i].live {
        let amount = 32_u64;
        let retained = True();
        if heap^.upvalues.inner[i].mark != epoch {
          if i < 4294967296_u64 {
            let h = cvt::<u64, u32>(i);
            free_upvalue(heap: heap, h: h);
            set freed = freed +wrap 1_u64;
            set upvalues.freed_objects = upvalues.freed_objects +sat 1_u64;
            set upvalues.freed_bytes = upvalues.freed_bytes +sat amount;
            set retained = False();
          }
        }
        if retained {
          set upvalues.live_objects = upvalues.live_objects +sat 1_u64;
          set upvalues.live_bytes = upvalues.live_bytes +sat amount;
        }
      }
      set i = i +wrap 1_u64;
    } else {
      break;
    }
  }
  set i = 0_u64;
  loop {
    if i < heap^.strings.inner.len {
      set strings.slots_visited = strings.slots_visited +sat 1_u64;
      if heap^.strings.inner[i].live {
        let amount = 24_u64 +sat heap^.strings.inner[i].payload.bytes.inner.cap;
        let retained = True();
        if heap^.strings.inner[i].mark != epoch {
          if i < 4294967296_u64 {
            let h = cvt::<u64, u32>(i);
            free_string(heap: heap, h: h);
            set freed = freed +wrap 1_u64;
            set strings.freed_objects = strings.freed_objects +sat 1_u64;
            set strings.freed_bytes = strings.freed_bytes +sat amount;
            set retained = False();
          }
        }
        if retained {
          set strings.live_objects = strings.live_objects +sat 1_u64;
          set strings.live_bytes = strings.live_bytes +sat amount;
        }
      }
      set i = i +wrap 1_u64;
    } else {
      break;
    }
  }
  set i = 0_u64;
  loop {
    if i < heap^.threads.inner.len {
      set threads.slots_visited = threads.slots_visited +sat 1_u64;
      if heap^.threads.inner[i].live {
        let amount = heap^.threads.inner[i].accounted_bytes;
        let retained = True();
        if heap^.threads.inner[i].mark != epoch {
          if i < 4294967296_u64 {
            let h = cvt::<u64, u32>(i);
            free_thread(heap: heap, h: h);
            set freed = freed +wrap 1_u64;
            set threads.freed_objects = threads.freed_objects +sat 1_u64;
            set threads.freed_bytes = threads.freed_bytes +sat amount;
            set retained = False();
          }
        }
        if retained {
          set threads.live_objects = threads.live_objects +sat 1_u64;
          set threads.live_bytes = threads.live_bytes +sat amount;
        }
      }
      set i = i +wrap 1_u64;
    } else {
      break;
    }
  }
  set heap^.collections = heap^.collections +sat 1_u64;
  set heap^.bytes_since_gc = 0_u64;
  let live = heap^.bytes;
  let threshold = collection_threshold(live: live, pause: heap^.gc_pause);
  set heap^.threshold = threshold;
  set heap^.last_collection = CollectionStats(strings: strings, tables: tables, closures: closures, upvalues: upvalues, threads: threads, gray_pops: heap^.gray_pops, next_threshold: threshold);
  return freed;
}

fn gc_due(heap: &Heap) -> r: Bool reads(heap) {
  doc "Collect when stress is enabled, the byte limit is exceeded, or allocation since the last collection exceeds its pause-derived threshold.";
  if heap^.gc_stress {
    return True();
  }
  if heap^.limit > 0_u64 {
    if heap^.bytes > heap^.limit {
      return True();
    }
  }
  return heap^.bytes_since_gc > heap^.threshold;
}
