        let local_a_43 = table_at(vm: vm, table: local_table_18, index: local_previous_42);
        let local_b_44 = table_at(vm: vm, table: local_table_18, index: local_frame_16.i);
        let local_ok_45 = table_swap(vm: vm, table: local_table_18, i: local_previous_42, j: local_frame_16.i, a: local_a_43, b: local_b_44);
        if bnot(local_ok_45) {
