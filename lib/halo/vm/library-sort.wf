        set local_frame_16.a = table_at(vm: vm, table: local_table_18, index: local_l_22);
        set local_frame_16.b = table_at(vm: vm, table: local_table_18, index: local_u_23);
        set local_frame_16.phase = 1_u8;
        sort_store(vm: vm, index: local_index_15, frame: local_frame_16);
        let local_ok_26 = sort_compare::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, context: context, a: local_frame_16.b, b: local_frame_16.a);
        if bnot(local_ok_26) {
          return False();
        }
      }
    } else if local_frame_16.phase == 1_u8 {
      if local_less_21 {
        let local_ok_27 = table_swap(vm: vm, table: local_table_18, i: local_l_22, j: local_u_23, a: local_frame_16.a, b: local_frame_16.b);
