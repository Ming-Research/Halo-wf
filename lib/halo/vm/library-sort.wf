      } else {
        let local_sum_29 = local_l_22 +wrap local_u_23;
        set local_frame_16.i = local_sum_29 / 2_i64;
        set local_frame_16.a = table_at(vm: vm, table: local_table_18, index: local_frame_16.i);
        set local_frame_16.b = table_at(vm: vm, table: local_table_18, index: local_l_22);
        set local_frame_16.phase = 3_u8;
        sort_store(vm: vm, index: local_index_15, frame: local_frame_16);
        let local_ok_30 = sort_compare::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, context: context, a: local_frame_16.a, b: local_frame_16.b);
        if bnot(local_ok_30) {
          return False();
        }
      }
    } else if local_frame_16.phase == 3_u8 {
      if local_less_21 {
        let local_ok_31 = table_swap(vm: vm, table: local_table_18, i: local_frame_16.i, j: local_l_22, a: local_frame_16.a, b: local_frame_16.b);
        if bnot(local_ok_31) {
