        sort_store(vm: vm, index: local_index_15, frame: local_frame_16);
        let local_ok_32 = sort_compare::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, context: context, a: local_frame_16.b, b: local_frame_16.a);
        if bnot(local_ok_32) {
