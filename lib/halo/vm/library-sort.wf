alias Value = pkg::value::Value;
alias Cell = pkg::value::Cell;
alias num_of = pkg::value::num_of;
alias str_of = pkg::value::str_of;
alias truthy = pkg::value::truthy;

const library_sort_sort_order_error: Array<u8, 34> = "invalid order function for sorting";

fn sort_push(vm: &Vm, context: u64, lower: i64, upper: i64) -> r: unit writes(vm) {
  let local_n_1 = vm^.sort_frames.inner.len;
  if local_n_1 == vm^.sort_frames.inner.cap {
    let local_cap_2 = local_n_1 +sat 1_u64;
    grow(cell: &vm^.sort_frames, capacity: local_cap_2);
  }
  let local_nil_3 = Value::Nil();
  let local_frame_4 = SortFrame(context: context, lower: lower, upper: upper, i: 0_i64, j: 0_i64, phase: 0_u8, a: local_nil_3, b: local_nil_3, pivot: local_nil_3);
  if vm^.sort_frames.inner.len < vm^.sort_frames.inner.cap {
    place_back(window: &vm^.sort_frames.inner, value: local_frame_4);
  }
  return unit;
}

fn sort_store(vm: &Vm, index: u64, frame: SortFrame) -> r: unit writes(vm) {
  if index < vm^.sort_frames.inner.len {
    set vm^.sort_frames.inner[index] = frame;
  }
  return unit;
}

fn sort_compare<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, context: u64, a: Value, b: Value) -> r: Bool reads(code), reads(consts), writes(stack), writes(vm), writes(env) {
  doc "ltablib.c sort_comp uses lua_lessthan in its native frame. Preserve both direct comparison errors and metamethod errors without adding the sort caller's location.";
  if context < vm^.library_contexts.inner.len {
    library_plan(vm: vm, index: context);
    let local_call_5 = vm^.library_contexts.inner[context];
    let local_dest_6 = local_call_5.frame.func;
    let local_nil_7 = Value::Nil();
    if is_nil(v: local_call_5.comparator) {
      match num_of(v: a) {
        Is(x: bound_x_1) => {
          match num_of(v: b) {
            Is(x: y) => {
              let local_less_8 = flt(bound_x_1, y);
              let local_value_9 = boolean(v: local_less_8);
              lib_put(stack: stack, at: local_dest_6, value: local_value_9);
              return True();
            }
            Not() => {
            }
          }
        }
        Not() => {
        }
      }
      match str_of(v: a) {
        Handle(h: left) => {
          match str_of(v: b) {
            Handle(h: right) => {
              let local_order_10 = string_order(vm: vm, b: left, c: right);
              let local_less_11 = local_order_10 < 0_i64;
              let local_value_12 = boolean(v: local_less_11);
              lib_put(stack: stack, at: local_dest_6, value: local_value_12);
              return True();
            }
            NoHandle() => {
            }
          }
        }
        NoHandle() => {
        }
      }
      let compared = sort_compare_slow::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, dest: local_dest_6, a: a, b: b);
      return compared;
    }
    let compared = callback::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, dest: local_dest_6, f: local_call_5.comparator, b: a, c: b, third: local_nil_7, argc: 2_u64, wanted: 1_i64, mode: 0_u8);
    return compared;
  }
  return False();
}

fn sort_compare_slow<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, dest: u64, a: Value, b: Value) -> r: Bool reads(code), reads(consts), writes(stack), writes(vm), writes(env) {
  doc "sort_comp's lua_lessthan for operands that are not two numbers or two strings, kept out of sort_compare so its number and string paths keep their shape. Its runtime errors are raised in the native sort frame, without the caller's location.";
  if dest < stack^.inner.len {
    let op = SlowOp::Lt();
    let nil = Value::Nil();
    let compared = slow::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, op: op, dest: dest, b: a, c: b, v: nil, breg: unlimited, creg: unlimited);
    let interrupted = bor(vm^.suspended, vm^.host_stopped);
    if bnot(interrupted) {
      if bnot(compared) {
        library_raw_error(vm: vm);
      }
    }
    return compared;
  }
  return False();
}

fn sort_start<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, vm: &Vm, stack: &Box<Slots<Value>>, env: &E, table: Value, comparator: Value, func: u64, upper: i64) -> r: Bool reads(code), reads(consts), writes(vm), writes(stack), writes(env) {
  doc "Select a synchronous raw-array auxsort only for homogeneous numbers or strings without a comparator; all other calls retain the resumable sort frames.";
  if is_nil(v: comparator) {
    match sort_array_table(vm: vm, table: table, upper: upper) {
      Some(value: slot) => {
        let sorted = sort_array_run(vm: vm, slot: slot, lower: 1_i64, upper: upper);
        return sorted;
      }
      None() => {
      }
    }
  }
  let local_context_14 = vm^.library_contexts.inner.len -sat 1_u64;
  sort_push(vm: vm, context: local_context_14, lower: 1_i64, upper: upper);
  return sort_run::<Host<E>>(code: code, consts: consts, vm: vm, stack: stack, env: env, context: local_context_14);
}

fn sort_array_table(vm: &Vm, table: Value, upper: i64) -> r: Option<u64> reads(vm) {
  doc "Require a live writable table whose entire aux_getn prefix is in its array and is all numbers or all live strings. Read-only tables retain the old swap-time refusal; metatables do not affect raw values.";
  if upper < 0_i64 {
    return None<u64>();
  }
  let count = cvt.wrap::<i64, u64>(upper);
  match pkg::value::tab_of(v: table) {
    Handle(h: handle) => {
      let slot = cvt::<u32, u64>(handle);
      if slot < vm^.heap.tables.inner.len {
        if bnot(vm^.heap.tables.inner[slot].live) {
          return None<u64>();
        }
        if vm^.heap.tables.inner[slot].payload.read_only {
          return None<u64>();
        }
        if count > vm^.heap.tables.inner[slot].payload.array.inner.len {
          return None<u64>();
        }
        let sort_kind = 0_u8;
        for (index in 0_u64..count) {
          if index < vm^.heap.tables.inner[slot].payload.array.inner.len {
            let item = vm^.heap.tables.inner[slot].payload.array.inner[index];
            match num_of(v: item) {
              Is(..) => {
                if sort_kind == 2_u8 {
                  return None<u64>();
                }
                set sort_kind = 1_u8;
              }
              Not() => {
                if sort_kind == 1_u8 {
                  return None<u64>();
                }
                match str_of(v: item) {
                  Handle(h: string_handle) => {
                    let string_slot = cvt::<u32, u64>(string_handle);
                    if string_slot >= vm^.heap.strings.inner.len {
                      return None<u64>();
                    }
                    if bnot(vm^.heap.strings.inner[string_slot].live) {
                      return None<u64>();
                    }
                    set sort_kind = 2_u8;
                  }
                  NoHandle() => {
                    return None<u64>();
                  }
                }
              }
            }
          } else {
            return None<u64>();
          }
        }
        return Some<u64>(value: slot);
      }
    }
    NoHandle() => {
    }
  }
  return None<u64>();
}

fn sort_array_at(vm: &Vm, slot: u64, index: i64) -> r: Value reads(vm.heap.tables) {
  doc "Read a one-based raw array index with slab liveness and window checks. Selection and auxsort's sentinels keep every accessed index in this array.";
  if slot < vm^.heap.tables.inner.len {
    if vm^.heap.tables.inner[slot].live {
      if index > 0_i64 {
        let offset = index - 1_i64;
        let at = cvt.wrap::<i64, u64>(offset);
        if at < vm^.heap.tables.inner[slot].payload.array.inner.len {
          return vm^.heap.tables.inner[slot].payload.array.inner[at];
        }
      }
    }
  }
  return Value::Nil();
}

fn sort_array_swap(vm: &Vm, slot: u64, i: i64, j: i64, a: Value, b: Value) -> r: Bool writes(vm.heap.tables) {
  doc "Perform set2's two writes in order without table lookup, allocation or a safepoint. The selected table stays writable and live throughout synchronous sorting.";
  if slot < vm^.heap.tables.inner.len {
    if vm^.heap.tables.inner[slot].live {
      if i > 0_i64 {
        if j > 0_i64 {
          let left_offset = i - 1_i64;
          let right_offset = j - 1_i64;
          let left = cvt.wrap::<i64, u64>(left_offset);
          let right = cvt.wrap::<i64, u64>(right_offset);
          if left < vm^.heap.tables.inner[slot].payload.array.inner.len {
            if right < vm^.heap.tables.inner[slot].payload.array.inner.len {
              set vm^.heap.tables.inner[slot].payload.flags = 0_u8;
              set vm^.heap.tables.inner[slot].payload.array.inner[left] = b;
              set vm^.heap.tables.inner[slot].payload.array.inner[right] = a;
              return True();
            }
          }
        }
      }
    }
  }
  return False();
}

fn sort_array_less(vm: &Vm, a: Value, b: Value) -> r: Bool reads(vm) {
  doc "The selected homogeneous values use exactly Lua's double less-than, including false for NaNs, or string_order's byte comparison including embedded zeros; neither operation calls Lua.";
  match num_of(v: a) {
    Is(x: left_number) => {
      match num_of(v: b) {
        Is(x: right_number) => {
          return flt(left_number, right_number);
        }
        Not() => {
        }
      }
    }
    Not() => {
    }
  }
  match str_of(v: a) {
    Handle(h: left_string) => {
      match str_of(v: b) {
        Handle(h: right_string) => {
          let order = string_order(vm: vm, b: left_string, c: right_string);
          return order < 0_i64;
        }
        NoHandle() => {
        }
      }
    }
    NoHandle() => {
    }
  }
  return False();
}

fn sort_array_run(vm: &Vm, slot: u64, lower: i64, upper: i64) -> r: Bool writes(vm) {
  doc "PUC Lua 5.1 ltablib.c auxsort (license in LICENSE.md): retain median-of-three comparisons and swaps, post-comparison invalid-order checks, smaller-half recursion and larger-half iteration. No Lua calls, budget charges, continuations or successful-path allocations occur.";
  let lo = lower;
  let hi = upper;
  loop {
    if lo >= hi {
      break;
    }
    let gap = hi -wrap lo;
    let a = sort_array_at(vm: vm, slot: slot, index: lo);
    let b = sort_array_at(vm: vm, slot: slot, index: hi);
    if sort_array_less(vm: vm, a: b, b: a) {
      let swapped = sort_array_swap(vm: vm, slot: slot, i: lo, j: hi, a: a, b: b);
      if bnot(swapped) {
        return False();
      }
    }
    if gap == 1_i64 {
      break;
    }
    let sum = lo +wrap hi;
    let middle = sum / 2_i64;
    set a = sort_array_at(vm: vm, slot: slot, index: middle);
    set b = sort_array_at(vm: vm, slot: slot, index: lo);
    if sort_array_less(vm: vm, a: a, b: b) {
      let swapped = sort_array_swap(vm: vm, slot: slot, i: middle, j: lo, a: a, b: b);
      if bnot(swapped) {
        return False();
      }
    } else {
      set b = sort_array_at(vm: vm, slot: slot, index: hi);
      if sort_array_less(vm: vm, a: b, b: a) {
        let swapped = sort_array_swap(vm: vm, slot: slot, i: middle, j: hi, a: a, b: b);
        if bnot(swapped) {
          return False();
        }
      }
    }
    if gap == 2_i64 {
      break;
    }
    let pivot = sort_array_at(vm: vm, slot: slot, index: middle);
    let previous = hi -wrap 1_i64;
    let displaced = sort_array_at(vm: vm, slot: slot, index: previous);
    let pivot_moved = sort_array_swap(vm: vm, slot: slot, i: middle, j: previous, a: pivot, b: displaced);
    if bnot(pivot_moved) {
      return False();
    }
    let i = lo;
    let j = previous;
    loop @partition {
      loop @scan_left {
        set i = i +wrap 1_i64;
        set a = sort_array_at(vm: vm, slot: slot, index: i);
        let less = sort_array_less(vm: vm, a: a, b: pivot);
        if bnot(less) {
          break @scan_left;
        }
        if i > hi {
          return raise_text(vm: vm, text: &library_sort_sort_order_error[0_u64..34_u64]);
        }
      }
      loop @scan_right {
        set j = j -wrap 1_i64;
        set b = sort_array_at(vm: vm, slot: slot, index: j);
        let less = sort_array_less(vm: vm, a: pivot, b: b);
        if bnot(less) {
          break @scan_right;
        }
        if j < lo {
          return raise_text(vm: vm, text: &library_sort_sort_order_error[0_u64..34_u64]);
        }
      }
      if j < i {
        break @partition;
      }
      let swapped = sort_array_swap(vm: vm, slot: slot, i: i, j: j, a: a, b: b);
      if bnot(swapped) {
        return False();
      }
    }
    set a = sort_array_at(vm: vm, slot: slot, index: previous);
    set b = sort_array_at(vm: vm, slot: slot, index: i);
    let pivot_placed = sort_array_swap(vm: vm, slot: slot, i: previous, j: i, a: a, b: b);
    if bnot(pivot_placed) {
      return False();
    }
    let left_size = i -wrap lo;
    let right_size = hi -wrap i;
    let before = i -wrap 1_i64;
    let after = i +wrap 1_i64;
    if left_size < right_size {
      let sorted = sort_array_run(vm: vm, slot: slot, lower: lo, upper: before);
      if bnot(sorted) {
        return False();
      }
      set lo = after;
    } else {
      let sorted = sort_array_run(vm: vm, slot: slot, lower: after, upper: hi);
      if bnot(sorted) {
        return False();
      }
      set hi = before;
    }
  }
  return True();
}

fn sort_run<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, vm: &Vm, stack: &Box<Slots<Value>>, env: &E, context: u64) -> r: Bool reads(code), reads(consts), writes(vm), writes(stack), writes(env) {
  doc "ltablib.c auxsort with its smaller-half recursion represented by SortFrame records. The phases preserve PUC's fetch, compare, swap and invalid-order checks; callback values and the pivot remain collector roots across reentrant Lua calls and budget suspension.";
  loop {
