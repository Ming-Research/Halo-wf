    }
    Tab(..) => {
      return 4_u8;
    }
    Fun(..) => {
      return 5_u8;
    }
    Builtin(id: null_id) => {
      if null_id == 111_u32 {
        return 6_u8;
      }
      return 5_u8;
    }
  }
}

fn is_nil(v: Value) -> r: Bool pure {
  let k = kind(v: v);
  return k == 0_u8;
}

fn boolean(v: Bool) -> r: Value pure {
  if v {
    return Value::True();
  }
  return Value::False();
}

