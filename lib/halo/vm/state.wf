fn stack_new(size: u64) -> r: Box<Slots<Value>> pure contract {
  ensures r.inner.len == size;
} {
  let s = box_slots_new::<Value>(capacity: size);
  resize_stack(stack: &s, size: size);
  return move s;
}

fn resize_stack(stack: &Box<Slots<Value>>, size: u64) -> r: unit writes(stack) contract {
  ensures stack^.inner.len == size;
} {
  if stack^.inner.cap < size {
    grow(cell: stack, capacity: size);
  }
  loop (
    invariant room: stack^.inner.len <= stack^.inner.cap
  ) {
    if stack^.inner.len >= size {
      break;
    }
    if stack^.inner.len < stack^.inner.cap {
      let nil = Value::Nil();
      place_back(window: &stack^.inner, value: nil);
    }
  }
  loop (
    invariant lower: stack^.inner.len >= size
  ) {
    if stack^.inner.len <= size {
      break;
    }
    let discarded = take_back(window: &stack^.inner);
  }
  return unit;
}

fn ensure_stack(stack: &Box<Slots<Value>>, size: u64) -> r: unit writes(stack) contract {
  ensures stack^.inner.len >= size;
  ensures stack^.inner.len >= entry(stack)^.inner.len;
} {
  if stack^.inner.len < size {
    resize_stack(stack: stack, size: size);
  }
  return unit;
}

fn push_frame(vm: &Vm, frame: Frame) -> r: Bool writes(vm) {
  let n = vm^.frames.inner.len;
  if n >= 20000_u64 {
    return raise_text(vm: vm, text: &calls_text_0[0_u64..14_u64]);
  }
  if n < 18446744073709551615_u64 {
    if n == vm^.frames.inner.cap {
      let cap = n * 2_u64;
      if cap < 32_u64 {
        set cap = 32_u64;
      }
      if cap > 20000_u64 {
        set cap = 20000_u64;
      }
      if cap >= vm^.frames.inner.cap {
        grow(cell: &vm^.frames, capacity: cap);
      }
    }
    if vm^.frames.inner.len < vm^.frames.inner.cap {
      place_back(window: &vm^.frames.inner, value: frame);
      return True();
    }
  }
  return False();
}

