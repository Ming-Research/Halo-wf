  let frames = box_slots_new::<Frame>(capacity: 32_u64);
  let opens = box_slots_new::<u32>(capacity: 0_u64);
  let protos = box_slots_new::<Proto>(capacity: 0_u64);
  let lineinfo = box_slots_new::<u32>(capacity: 0_u64);
  let debug_names = box_slots_new::<u8>(capacity: 0_u64);
  let local_variables = box_slots_new::<LocalVariable>(capacity: 0_u64);
  let upvalue_names = box_slots_new::<DebugName>(capacity: 0_u64);
  let source = box_slots_new::<u8>(capacity: 0_u64);
  let nil = Value::Nil();
  let stopped_stack = box_slots_new::<Value>(capacity: 0_u64);
  let atom3 = False();
  let callbacks = box_slots_new::<CallbackFrame>(capacity: 0_u64);
  let callback_plan = CallbackPlan(pc: 0_u64, base: 0_u64, kbase: 0_u64, kind: 0_u8, dest: 0_u64, first: 0_u64, index: 0_u64, target: 0_u64, expected: atom3);
  let type_metatables = array_filled::<u32, 6>(value: no_handle);
  let library_contexts = box_slots_new::<LibraryContext>(capacity: 0_u64);
  let sort_frames = box_slots_new::<SortFrame>(capacity: 0_u64);
  let pattern_subs = box_slots_new::<PatternSubFrame>(capacity: 0_u64);
  let cjson_configs = box_slots_new::<CjsonConfig>(capacity: 16_u64);
  let pcall_field = box_slots_new::<u8>(capacity: 0_u64);
  let no_call = PendingCall(id: 0_u32, argc: 0_u64, func: 0_u64, wanted: 0_i64, return_pc: 0_u64, base: 0_u64, kbase: 0_u64, tail: atom3, activation: 0_u32, top: 0_u64);
  return Vm(pattern_subs: move pattern_subs, cjson_configs: move cjson_configs, cjson_active_config: 0_u64, library_contexts: move library_contexts, sort_frames: move sort_frames, random_state: 20017429951246_u64, heap: move heap, frames: move frames, open_upvalues: move opens, protos: move protos, lineinfo: move lineinfo, source: move source, debug_names: move debug_names, local_variables: move local_variables, upvalue_names: move upvalue_names, top: 0_u64, budget: unlimited, saved_pc: 0_u64, saved_base: 0_u64, saved_kbase: 0_u64, error: nil, activation: 0_u32, globals: gh, type_metatables: type_metatables, host_stopped: atom3, stopped_stack: move stopped_stack, callback_plan: callback_plan, callbacks: move callbacks, suspended: atom3, pending: no_call, call_pending: atom3, raise_pc: 0_u64, pcall_field: move pcall_field);
}

fn raise_text(vm: &Vm, text: &[u8]) -> r: Bool reads(text), writes(vm) {
  let v = intern(heap: &vm^.heap, bytes: text);
  set vm^.error = v;
  return False();
}

fn raw_type_error(vm: &Vm, v: Value, op: u8) -> r: Bool writes(vm) {
  if cjson_isnull(value: v) {
    if op == 0_u8 {
      return raise_text(vm: vm, text: &cj_nullarith[0_u64..49_u64]);
    }
    if op == 1_u8 {
      return raise_text(vm: vm, text: &cj_nullindex[0_u64..33_u64]);
    }
    if op == 2_u8 {
      return raise_text(vm: vm, text: &cj_nullcall[0_u64..32_u64]);
    }
    if op == 3_u8 {
      return raise_text(vm: vm, text: &cj_nullconcat[0_u64..39_u64]);
    }
    return raise_text(vm: vm, text: &cj_nulllen[0_u64..41_u64]);
  }
  let k = kind(v: v);
  if op == 0_u8 {
    if k == 0_u8 {
      return raise_text(vm: vm, text: &state_text_0[0_u64..44_u64]);
    }
    if k == 1_u8 {
      return raise_text(vm: vm, text: &state_text_1[0_u64..48_u64]);
    }
    if k == 3_u8 {
      return raise_text(vm: vm, text: &state_text_2[0_u64..47_u64]);
    }
    if k == 4_u8 {
      return raise_text(vm: vm, text: &state_text_3[0_u64..46_u64]);
    }
    return raise_text(vm: vm, text: &state_text_4[0_u64..49_u64]);
  }
  if op == 1_u8 {
    if k == 0_u8 {
      return raise_text(vm: vm, text: &state_text_5[0_u64..28_u64]);
    }
    if k == 1_u8 {
      return raise_text(vm: vm, text: &state_text_6[0_u64..32_u64]);
    }
    if k == 2_u8 {
      return raise_text(vm: vm, text: &state_text_7[0_u64..31_u64]);
    }
    if k == 3_u8 {
      return raise_text(vm: vm, text: &state_text_8[0_u64..31_u64]);
    }
    return raise_text(vm: vm, text: &state_text_9[0_u64..33_u64]);
  }
  if op == 2_u8 {
    if k == 0_u8 {
      return raise_text(vm: vm, text: &state_text_10[0_u64..27_u64]);
    }
    if k == 1_u8 {
      return raise_text(vm: vm, text: &state_text_11[0_u64..31_u64]);
    }
    if k == 2_u8 {
      return raise_text(vm: vm, text: &state_text_12[0_u64..30_u64]);
    }
    if k == 3_u8 {
      return raise_text(vm: vm, text: &state_text_13[0_u64..30_u64]);
    }
    return raise_text(vm: vm, text: &state_text_14[0_u64..29_u64]);
  }
  if op == 3_u8 {
    if k == 0_u8 {
      return raise_text(vm: vm, text: &state_text_15[0_u64..34_u64]);
    }
    if k == 1_u8 {
      return raise_text(vm: vm, text: &state_text_16[0_u64..38_u64]);
    }
    if k == 2_u8 {
      return raise_text(vm: vm, text: &state_text_17[0_u64..37_u64]);
    }
    if k == 4_u8 {
      return raise_text(vm: vm, text: &state_text_18[0_u64..36_u64]);
    }
    return raise_text(vm: vm, text: &state_text_19[0_u64..39_u64]);
  }
  if k == 0_u8 {
    return raise_text(vm: vm, text: &state_text_20[0_u64..36_u64]);
  }
  if k == 1_u8 {
    return raise_text(vm: vm, text: &state_text_21[0_u64..40_u64]);
  }
  if k == 2_u8 {
    return raise_text(vm: vm, text: &state_text_22[0_u64..39_u64]);
  }
  return raise_text(vm: vm, text: &state_text_23[0_u64..41_u64]);
}

fn coerce_number(vm: &Vm, v: Value) -> r: pkg::value::NumView reads(vm) {
  match num_of(v: v) {
    Is(x: bound_x_1) => {
      return pkg::value::NumView::Is(x: bound_x_1);
    }
    Not() => {
    }
  }
  match str_of(v: v) {
    Handle(h: bound_h_2) => {
      let i = cvt::<u32, u64>(bound_h_2);
      if i < vm^.heap.strings.inner.len {
        let n = vm^.heap.strings.inner[i].payload.bytes.inner.len;
        match pkg::number::str2number(bytes: &vm^.heap.strings.inner[i].payload.bytes.inner[0_u64..n]) {
          Some(value: x) => {
            return pkg::value::NumView::Is(x: x);
          }
          None() => {
          }
        }
      }
    }
    NoHandle() => {
    }
  }
  return pkg::value::NumView::Not();
}

fn coerce_string(vm: &Vm, v: Value) -> r: Value writes(vm) {
  match num_of(v: v) {
    Is(x: bound_x_3) => {
      let bytes = array_filled::<u8, 32>(value: 0_u8);
      let n = pkg::number::format_number(value: bound_x_3, out: &bytes[0_u64..32_u64]);
      return intern(heap: &vm^.heap, bytes: &bytes[0_u64..n]);
    }
    Not() => {
      return v;
    }
  }
}

fn upvalue_handle(vm: &Vm, u: u8) -> r: Option<u32> reads(vm) {
  let n = vm^.frames.inner.len;
  if n > 0_u64 {
    let f = n - 1_u64;
    let cl = cvt::<u32, u64>(vm^.frames.inner[f].closure);
    if cl < vm^.heap.closures.inner.len {
      let i = cvt::<u8, u64>(u);
      if i < vm^.heap.closures.inner[cl].payload.upvals.inner.len {
        let h = vm^.heap.closures.inner[cl].payload.upvals.inner[i];
        return Some<u32>(value: h);
      }
    }
  }
  return None<u32>();
}

fn read_upvalue(vm: &Vm, stack: &Box<Slots<Value>>, h: u32) -> r: Value reads(vm), reads(stack) {
  let i = cvt::<u32, u64>(h);
  if i < vm^.heap.upvalues.inner.len {
    match vm^.heap.upvalues.inner[i].payload {
      Open(slot: s) => {
        let j = s^;
        if j < stack^.inner.len {
          return stack^.inner[j];
        }
      }
      Closed(v: bound_v_3) => {
        return bound_v_3^;
      }
    }
  }
  return Value::Nil();
}

fn write_upvalue(vm: &Vm, stack: &Box<Slots<Value>>, h: u32, v: Value) -> r: unit writes(vm), writes(stack) contract {
  ensures stack^.inner.len == entry(stack)^.inner.len;
} {
  let i = cvt::<u32, u64>(h);
  if i < vm^.heap.upvalues.inner.len {
    match vm^.heap.upvalues.inner[i].payload {
      Open(slot: s) => {
        let j = s^;
        if j < stack^.inner.len {
          set stack^.inner[j] = v;
        }
      }
      Closed(..) => {
        set vm^.heap.upvalues.inner[i].payload = Upval::Closed(v: v);
      }
    }
  }
  return unit;
}

fn capture(vm: &Vm, slot: u64) -> r: Option<u32> writes(vm) {
  let at = vm^.open_upvalues.inner.len;
  for (i in 0_u64..vm^.open_upvalues.inner.len) {
    if i < vm^.open_upvalues.inner.len {
      let h = vm^.open_upvalues.inner[i];
      let j = cvt::<u32, u64>(h);
      if j < vm^.heap.upvalues.inner.len {
        match vm^.heap.upvalues.inner[j].payload {
          Open(slot: s) => {
            if s^ == slot {
              return Some<u32>(value: h);
            }
            if s^ < slot {
              if i < at {
                set at = i;
              }
            }
          }
          Closed(..) => {
          }
        }
      }
    }
  }
  let uv = Upval::Open(slot: slot);
  match pkg::heap::new_upvalue(heap: &vm^.heap, value: uv) {
    None() => {
      return None<u32>();
    }
    Some(value: h) => {
      let n = vm^.open_upvalues.inner.len;
      if n < unlimited {
        if n == vm^.open_upvalues.inner.cap {
          let cap = n + 1_u64;
          grow(cell: &vm^.open_upvalues, capacity: cap);
        }
        if at <= vm^.open_upvalues.inner.len {
          if vm^.open_upvalues.inner.len < vm^.open_upvalues.inner.cap {
            insert_at(window: &vm^.open_upvalues.inner, index: at, value: h);
            return Some<u32>(value: h);
          }
        }
      }
    }
  }
  return None<u32>();
}

fn close_upvalues(vm: &Vm, stack: &Box<Slots<Value>>, level: u64) -> r: unit reads(stack), writes(vm) {
  loop {
    if vm^.open_upvalues.inner.len == 0_u64 {
      break;
    }
    let h = vm^.open_upvalues.inner[0_u64];
    let i = cvt::<u32, u64>(h);
    if i < vm^.heap.upvalues.inner.len {
      match vm^.heap.upvalues.inner[i].payload {
        Open(slot: s) => {
          let j = s^;
          if j < level {
            break;
          }
          let v = Value::Nil();
          if j < stack^.inner.len {
            set v = stack^.inner[j];
          }
          set vm^.heap.upvalues.inner[i].payload = Upval::Closed(v: v);
        }
        Closed(..) => {
        }
      }
    }
    if vm^.open_upvalues.inner.len > 0_u64 {
      let removed = remove_at(window: &vm^.open_upvalues.inner, index: 0_u64);
    }
  }
  return unit;
}

fn reset(vm: &Vm, stack: &Box<Slots<Value>>) -> r: unit writes(stack), writes(vm) {
  loop {
    if vm^.pattern_subs.inner.len == 0_u64 {
      break;
    }
    let discarded = take_back(window: &vm^.pattern_subs.inner);
  }
  loop {
    if vm^.library_contexts.inner.len == 0_u64 {
      break;
    }
    let discarded = take_back(window: &vm^.library_contexts.inner);
  }
  loop {
    if vm^.sort_frames.inner.len == 0_u64 {
      break;
    }
    let discarded = take_back(window: &vm^.sort_frames.inner);
  }
  if vm^.suspended {
    restore_stopped_stack(vm: vm, stack: stack);
  }
  set vm^.suspended = False();
  loop {
    if vm^.callbacks.inner.len == 0_u64 {
      break;
    }
    let removed = take_back(window: &vm^.callbacks.inner);
  }
  close_upvalues(vm: vm, stack: stack, level: 0_u64);
  loop {
    if vm^.frames.inner.len == 0_u64 {
      break;
    }
    let f = take_back(window: &vm^.frames.inner);
  }
  set vm^.top = 0_u64;
  set vm^.activation = 0_u32;
  set vm^.host_stopped = False();
  set vm^.call_pending = False();
  set vm^.raise_pc = 0_u64;
  let empty = box_slots_new::<Value>(capacity: 0_u64);
  set vm^.stopped_stack = move empty;
  set vm^.error = Value::Nil();
  return unit;
}

fn note_raise(vm: &Vm, pc: u64) -> r: unit writes(vm.raise_pc) {
  doc "Records pc as the raise point of the error now propagating, unless one is recorded: the first dispatch run an error leaves is the frame that raised it, and the runs and callbacks it then propagates through keep that record until a pcall or xpcall catches the error.";
  if vm^.raise_pc == 0_u64 {
    set vm^.raise_pc = pc +sat 1_u64;
  }
  return unit;
}

fn charge_budget(vm: &Vm, pc: u64, base: u64, kbase: u64) -> r: Bool writes(vm) {
  let b = vm^.budget;
  if b == 0_u64 {
    set vm^.saved_pc = pc;
    set vm^.saved_base = base;
    set vm^.saved_kbase = kbase;
    return False();
  }
  if b != unlimited {
    set vm^.budget = b - 1_u64;
  }
  return True();
}

fn register_value(stack: &Box<Slots<Value>>, base: u64, operand: u8) -> r: Value reads(stack) contract {
  requires base + 256_u64 <= stack^.inner.len;
} {
  let offset = cvt::<u8, u64>(operand);
  let index = base + offset;
  return stack^.inner[index];
}

fn constant_value(consts: &Box<Slots<Value>>, kbase: u64, operand: u8) -> r: Value reads(consts) contract {
  requires kbase + 256_u64 <= consts^.inner.len;
} {
  let offset = cvt::<u8, u64>(operand);
  let index = kbase + offset;
  return consts^.inner[index];
}

fn checked_frame(stack: &Box<Slots<Value>>, base: u64) -> r: Result<u64, unit> reads(stack) contract {
  ensures when Ok(value: b): b == base;
  ensures when Ok(value: b): b + 256_u64 <= stack^.inner.len;
} {
  if base <= 18446744073709551359_u64 {
    let limit = base + 256_u64;
    if limit <= stack^.inner.len {
      return Ok<u64, unit>(value: base);
    }
  }
  return Err<u64, unit>(error: unit);
}

fn register_slot(stack: &Box<Slots<Value>>, base: u64, operand: u8) -> r: u64 reads(stack) contract {
  requires base + 256_u64 <= stack^.inner.len;
  ensures r < stack^.inner.len;
} {
  let offset = cvt::<u8, u64>(operand);
  let index = base + offset;
  let extent = stack^.inner.len;
  return index;
}

fn park_stopped_stack(vm: &Vm, stack: &Box<Slots<Value>>) -> r: unit reads(stack), writes(vm) {
  if vm^.host_stopped {
    return unit;
  }
  let count = stack^.inner.len;
  let saved = box_slots_new::<Value>(capacity: count);
  for (i in 0_u64..count) {
    if saved.inner.len < saved.inner.cap {
      let value = stack^.inner[i];
      place_back(window: &saved.inner, value: value);
    }
  }
  set vm^.stopped_stack = move saved;
  set vm^.host_stopped = True();
  return unit;
}

fn restore_stopped_stack(vm: &Vm, stack: &Box<Slots<Value>>) -> r: unit writes(vm), writes(stack) {
  let count = vm^.stopped_stack.inner.len;
  resize_stack(stack: stack, size: count);
  for (i in 0_u64..count) {
    set stack^.inner[i] = vm^.stopped_stack.inner[i];
  }
  if bnot(vm^.host_stopped) {
    let empty = box_slots_new::<Value>(capacity: 0_u64);
    set vm^.stopped_stack = move empty;
  }
  return unit;
}

fn unnamed_type_error(vm: &Vm, v: Value, op: u8) -> r: Bool writes(vm) {
  doc "Raises a type error for a value outside a Lua frame's register window.";
  let rejected = raw_type_error(vm: vm, v: v, op: op);
  locate_type_error(vm: vm);
  return rejected;
}

fn type_error(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, vm: &Vm, v: Value, op: u8, reg: u64) -> r: Bool reads(code), reads(consts), writes(vm) {
  doc "luaG_typeerror: reg is frame-relative, or unlimited for an operand outside the Lua stack. Descriptions are recovered only on this error path.";
  let description = box_slots_new::<u8>(capacity: 0_u64);
  let named = describe_operand(code: code, consts: consts, vm: vm, reg: reg, bytes: &description);
  if named {
    let bytes = box_slots_new::<u8>(capacity: 0_u64);
    bytes_append(bytes: &bytes, text: &name_attempt[0_u64..11_u64]);
    if op == 0_u8 {
      bytes_append(bytes: &bytes, text: &name_arithmetic[0_u64..21_u64]);
    } else if op == 1_u8 {
      bytes_append(bytes: &bytes, text: &name_index[0_u64..5_u64]);
    } else if op == 2_u8 {
      bytes_append(bytes: &bytes, text: &name_call[0_u64..4_u64]);
    } else if op == 3_u8 {
      bytes_append(bytes: &bytes, text: &name_concat[0_u64..11_u64]);
    } else {
      bytes_append(bytes: &bytes, text: &name_length[0_u64..13_u64]);
    }
    bytes_push(bytes: &bytes, byte: 32_u8);
    let length = description.inner.len;
    bytes_append(bytes: &bytes, text: &description.inner[0_u64..length]);
    bytes_append(bytes: &bytes, text: &name_type_prefix[0_u64..4_u64]);
    let typename = kind_name(vm: vm, v: v);
    bytes_string(vm: vm, bytes: &bytes, value: typename);
    bytes_append(bytes: &bytes, text: &name_type_suffix[0_u64..7_u64]);
    set vm^.error = bytes_value(vm: vm, bytes: &bytes);
    locate_type_error(vm: vm);
    return False();
  }
  return unnamed_type_error(vm: vm, v: v, op: op);
}

fn fault_cell(vm: &Vm) -> r: u64 reads(vm.callback_plan) {
  doc "The faulting cell shared by operand descriptions and error_location, including resumed concatenations.";
  let plan = vm^.callback_plan;
  let pc = plan.pc;
  if plan.kind != 2_u8 {
    set pc = pc -sat 1_u64;
  }
  return pc;
}

fn locate_type_error(vm: &Vm) -> r: unit writes(vm) {
  doc "Adds the existing Lua source location to a type error in the current activation.";
  let count = vm^.frames.inner.len;
  if count == 0_u64 {
    return unit;
  }
  let last = count - 1_u64;
  let frame = vm^.frames.inner[last];
  if frame.activation != vm^.activation {
    return unit;
  }
  let pc = fault_cell(vm: vm);
  let message = vm^.error;
  set vm^.error = error_location(vm: vm, pc: pc, level: 1_u64, message: message);
  return unit;
}

const cj_nullarith: Array<u8, 49> = "attempt to perform arithmetic on a userdata value";

const cj_nullindex: Array<u8, 33> = "attempt to index a userdata value";

const cj_nullcall: Array<u8, 32> = "attempt to call a userdata value";

const cj_nullconcat: Array<u8, 39> = "attempt to concatenate a userdata value";

const cj_nulllen: Array<u8, 41> = "attempt to get length of a userdata value";

// Ports ldebug.c symbexec/getobjname/kname and lfunc.c luaF_getlocalname.
// The Lua MIT notice in LICENSE.md applies to this file.
struct NameOrigin {
  kind: u8;
  index: u64;
}

const name_attempt: Array<u8, 11> = "attempt to ";

const name_arithmetic: Array<u8, 21> = "perform arithmetic on";

const name_index: Array<u8, 5> = "index";

const name_call: Array<u8, 4> = "call";

const name_concat: Array<u8, 11> = "concatenate";

const name_length: Array<u8, 13> = "get length of";

const name_type_prefix: Array<u8, 4> = " (a ";

const name_type_suffix: Array<u8, 7> = " value)";

const name_local: Array<u8, 5> = "local";

const name_global: Array<u8, 6> = "global";

const name_field: Array<u8, 5> = "field";

const name_upvalue: Array<u8, 7> = "upvalue";

const name_method: Array<u8, 6> = "method";

fn symbolic_name(code: &Box<Slots<Cell>>, vm: &Vm, proto: Proto, lastpc: u64, reg: u64) -> r: NameOrigin reads(code), reads(vm.protos) {
  doc "symbexec tracks the last writer before lastpc. A neutral origin is the final RETURN default; validation already checked the stream. kind 6 is MOVE recursion, not a displayed kind.";
  let last = NameOrigin(kind: 0_u8, index: 0_u64);
  let pc = cvt::<u32, u64>(proto.start);
  loop {
    if pc >= lastpc {
      break;
    }
    if pc >= code^.inner.len {
      break;
    }
    let cell = code^.inner[pc];
    let changed = False();
    let origin = NameOrigin(kind: 0_u8, index: 0_u64);
    let next = pc +sat 1_u64;
    let jump = unlimited;
    // lopcodes.c's A column, followed by symbexec's opcode-specific writes.
    match cell {
      Move(a: traced_a, b: traced_b) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        if traced_b < traced_a {
          let source = cvt::<u8, u64>(traced_b);
          set origin = NameOrigin(kind: 6_u8, index: source);
        }
      }
      LoadK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      LoadKx(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      LoadBool(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // LOADBOOL skip only validates in symbexec; it does not advance the walk.
      }
      LoadNil(a: traced_a, b: traced_b) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        let end = cvt::<u8, u64>(traced_b);
        let above = dest <= reg;
        let below = reg <= end;
        set changed = band(above, below);
      }
      GetUpval(a: traced_a, u: traced_u) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        let index = cvt::<u8, u64>(traced_u);
        set origin = NameOrigin(kind: 4_u8, index: index);
      }
      SetUpval(..) => {
      }
      GetGlobal(a: traced_a, k: traced_k) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        let index = cvt::<u8, u64>(traced_k);
        set origin = NameOrigin(kind: 2_u8, index: index);
      }
      SetGlobal(..) => {
      }
      GetGlobalX(a: traced_a, k: traced_k) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        let index = cvt::<u32, u64>(traced_k);
        set origin = NameOrigin(kind: 2_u8, index: index);
      }
      SetGlobalX(..) => {
      }
      GetTableR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        set origin = NameOrigin(kind: 3_u8, index: unlimited);
      }
      GetTableK(a: traced_a, k: traced_k, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        let index = cvt::<u8, u64>(traced_k);
        set origin = NameOrigin(kind: 3_u8, index: index);
      }
      SetTableRR(..) => {
      }
      SetTableRK(..) => {
      }
      SetTableKR(..) => {
      }
      SetTableKK(..) => {
      }
      NewTable(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      SelfR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // OP_SELF also changed traced_a+1; either destination retains the method origin.
        let self = dest + 1_u64;
        let receiver = self == reg;
        set changed = bor(changed, receiver);
        set origin = NameOrigin(kind: 5_u8, index: unlimited);
      }
      SelfK(a: traced_a, k: traced_k, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // OP_SELF also changed traced_a+1; either destination retains the method origin.
        let self = dest + 1_u64;
        let receiver = self == reg;
        set changed = bor(changed, receiver);
        let index = cvt::<u8, u64>(traced_k);
        set origin = NameOrigin(kind: 5_u8, index: index);
      }
      AddRR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      AddRK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      AddKR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      AddKK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      SubRR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      SubRK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      SubKR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      SubKK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      MulRR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      MulRK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      MulKR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      MulKK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      DivRR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      DivRK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      DivKR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      DivKK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      ModRR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      ModRK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      ModKR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      ModKK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      PowRR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      PowRK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      PowKR(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      PowKK(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      Unm(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      Not(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      Len(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      Concat(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
      }
      Jmp(target: traced_target) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      EqJmpRR(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      EqJmpRK(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      EqJmpKR(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      EqJmpKK(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      LtJmpRR(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      LtJmpRK(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      LtJmpKR(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      LtJmpKK(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      LeJmpRR(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      LeJmpRK(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      LeJmpKR(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      LeJmpKK(target: traced_target, ..) => {
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      TestJmp(a: traced_a, target: traced_target, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      TestSetJmp(a: traced_a, target: traced_target, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      Call(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // OP_CALL/OP_TAILCALL invalidate every register at or above A.
        set changed = reg >= dest;
      }
      TailCall(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // OP_CALL/OP_TAILCALL invalidate every register at or above A.
        set changed = reg >= dest;
      }
      Return(..) => {
      }
      ForLoop(a: traced_a, target: traced_target) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      ForPrep(a: traced_a, target: traced_target) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      TForLoop(a: traced_a, target: traced_target, ..) => {
        let base = cvt::<u8, u64>(traced_a);
        let first = base + 2_u64;
        set changed = reg >= first;
        // The absorbed JMP is visited after its test, including TFORLOOP.
        set jump = cvt::<u32, u64>(traced_target);
      }
      SetList(..) => {
        // Assembly already absorbed the extra SETLIST count word.
      }
      Close(..) => {
      }
      Closure(a: traced_a, proto: child_proto) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // OP_CLOSURE pc += nup: assembly retains capture pseudo-cells.
        let child = cvt::<u32, u64>(child_proto);
        if child < vm^.protos.inner.len {
          let count = vm^.protos.inner[child].nups;
          let captures = cvt::<u8, u64>(count);
          set next = next +sat captures;
        }
      }
      VarArg(a: traced_a, ..) => {
        let dest = cvt::<u8, u64>(traced_a);
        set changed = dest == reg;
        // OP_VARARG has only the A-column write, even for multiple results.
      }
    }
    if changed {
      set last = origin;
    }
    // symbexec OP_JMP/OP_FORPREP/OP_FORLOOP: pc += b then loop pc++.
    // Cell targets already denote that next instruction; backward edges are ignored.
    if pc < jump {
      if jump <= lastpc {
        set next = jump;
      }
    }
    set pc = next;
  }
  return last;
}

fn local_name(vm: &Vm, proto: Proto, pc: u64, reg: u64) -> r: Option<DebugName> reads(vm.local_variables) {
  doc "luaF_getlocalname counts active declarations in registration order, not register assignments.";
  let remaining = reg;
  for (i in 0_u64..proto.local_count) {
    let at = proto.local_base +sat i;
    if at < vm^.local_variables.inner.len {
      let record = vm^.local_variables.inner[at];
      let start = cvt::<u32, u64>(record.startcell);
      let end = cvt::<u32, u64>(record.endcell);
      if start > pc {
        break;
      }
      if pc < end {
        if remaining == 0_u64 {
          return Some<DebugName>(value: record.name);
        }
        set remaining = remaining - 1_u64;
      }
    }
  }
  return None<DebugName>();
}

fn append_debug_name(vm: &Vm, bytes: &Box<Slots<u8>>, name: DebugName) -> r: unit reads(vm.debug_names), writes(bytes) {
  doc "Appends a name from non-heap script metadata, with Lua's C-string boundary.";
  for (i in 0_u64..name.length) {
    let at = name.offset +sat i;
    if at < vm^.debug_names.inner.len {
      let byte = vm^.debug_names.inner[at];
      if byte == 0_u8 {
        break;
      }
      bytes_push(bytes: bytes, byte: byte);
    }
  }
  return unit;
}

fn append_constant_name(consts: &Box<Slots<Value>>, vm: &Vm, proto: Proto, index: u64, bytes: &Box<Slots<u8>>) -> r: unit reads(consts), reads(vm.heap), writes(bytes) {
  doc "ldebug.c kname: only a string constant supplies text; register and non-string keys supply question mark. luaG_runerror uses percent-s, so embedded NUL ends the name.";
  let base = cvt::<u32, u64>(proto.kbase);
  let at = base +sat index;
  if at < consts^.inner.len {
    let value = consts^.inner[at];
    match pkg::value::str_of(v: value) {
      Handle(h: handle) => {
        let h = cvt::<u32, u64>(handle);
        if h < vm^.heap.strings.inner.len {
          let length = vm^.heap.strings.inner[h].payload.bytes.inner.len;
          for (i in 0_u64..length) {
            if i < vm^.heap.strings.inner[h].payload.bytes.inner.len {
              let byte = vm^.heap.strings.inner[h].payload.bytes.inner[i];
              if byte == 0_u8 {
                break;
              }
              bytes_push(bytes: bytes, byte: byte);
            }
          }
          return unit;
        }
      }
      NoHandle() => {
      }
    }
  }
  bytes_push(bytes: bytes, byte: 63_u8);
  return unit;
}

fn describe_operand(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, vm: &Vm, reg: u64, bytes: &Box<Slots<u8>>) -> r: Bool reads(code), reads(consts), reads(vm), writes(bytes) {
  doc "getobjname tries active locals first, then the symbolic last writer, recursing on decreasing MOVE sources at the same faulting cell. Native frames and external values have no name.";
  if reg == unlimited {
    return False();
  }
  let count = vm^.frames.inner.len;
  if count == 0_u64 {
    return False();
  }
  let last = count - 1_u64;
  let frame = vm^.frames.inner[last];
  if frame.activation != vm^.activation {
    return False();
  }
  let closure = cvt::<u32, u64>(frame.closure);
  if closure >= vm^.heap.closures.inner.len {
    return False();
  }
  let callee = vm^.heap.closures.inner[closure].payload.callee;
  let id = unlimited;
  match callee {
    Lua(proto: index) => {
      set id = cvt::<u32, u64>(index);
    }
    Native(..) => {
      return False();
    }
  }
  if id >= vm^.protos.inner.len {
    return False();
  }
  let proto = vm^.protos.inner[id];
  let pc = fault_cell(vm: vm);
  let position = reg;
  loop {
    let local = local_name(vm: vm, proto: proto, pc: pc, reg: position);
    match local {
      Some(value: name) => {
        bytes_append(bytes: bytes, text: &name_local[0_u64..5_u64]);
        bytes_push(bytes: bytes, byte: 32_u8);
        bytes_push(bytes: bytes, byte: 39_u8);
        append_debug_name(vm: vm, bytes: bytes, name: name);
        bytes_push(bytes: bytes, byte: 39_u8);
        return True();
      }
      None() => {
      }
    }
    let origin = symbolic_name(code: code, vm: vm, proto: proto, lastpc: pc, reg: position);
    if origin.kind == 6_u8 {
      // getobjname(MOVE) repeats at currentpc, not at the MOVE instruction.
      set position = origin.index;
    } else {
      if origin.kind == 0_u8 {
        return False();
      }
      if origin.kind == 2_u8 {
        bytes_append(bytes: bytes, text: &name_global[0_u64..6_u64]);
      } else if origin.kind == 3_u8 {
        bytes_append(bytes: bytes, text: &name_field[0_u64..5_u64]);
      } else if origin.kind == 4_u8 {
        bytes_append(bytes: bytes, text: &name_upvalue[0_u64..7_u64]);
      } else {
        bytes_append(bytes: bytes, text: &name_method[0_u64..6_u64]);
      }
      bytes_push(bytes: bytes, byte: 32_u8);
      bytes_push(bytes: bytes, byte: 39_u8);
      if origin.kind == 4_u8 {
        let at = proto.upvalue_name_base +sat origin.index;
        if at < vm^.upvalue_names.inner.len {
          let name = vm^.upvalue_names.inner[at];
          append_debug_name(vm: vm, bytes: bytes, name: name);
        } else {
          bytes_push(bytes: bytes, byte: 63_u8);
        }
      } else {
        append_constant_name(consts: consts, vm: vm, proto: proto, index: origin.index, bytes: bytes);
      }
      bytes_push(bytes: bytes, byte: 39_u8);
      return True();
    }
  }
}

fn call_type_error(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, vm: &Vm, v: Value, func: u64, return_pc: u64) -> r: Bool reads(code), reads(consts), writes(vm) {
  doc "ldo.c tryfuncTM describes CALL/TAILCALL's function slot. TFORLOOP uses A+3 in its Lua caller even though Halo invokes the iterator through a nested activation; builtin callbacks have no Lua operand.";
  let reg = unlimited;
  let activation = vm^.activation;
  let saved_plan = vm^.callback_plan;
  let count = vm^.frames.inner.len;
  if count > 0_u64 {
    let last = count - 1_u64;
    let frame = vm^.frames.inner[last];
    if frame.activation == activation {
      // CALL's fast path does not install a callback plan. Only an actual
      // Lua caller can supply its return_pc; a pcall marker is a native frame.
      if frame.closure != no_handle {
        let plan = saved_plan;
        set plan.pc = return_pc;
        set plan.base = frame.base;
        set plan.kbase = frame.kbase;
        set plan.kind = 0_u8;
        set vm^.callback_plan = plan;
      }
      let base = frame.base;
      let top = frame.frame_top;
      if func >= base {
        if func < top {
          set reg = func - base;
        }
      }
    } else {
      let nested = frame.activation +sat 1_u32;
      if nested == activation {
        let plan = vm^.callback_plan;
        if plan.kind == 3_u8 {
          set reg = plan.dest -sat plan.base;
          set vm^.activation = frame.activation;
        }
      }
    }
  }
  let failed = type_error(code: code, consts: consts, vm: vm, v: v, op: 2_u8, reg: reg);
  set vm^.activation = activation;
  set vm^.callback_plan = saved_plan;
  return failed;
}
