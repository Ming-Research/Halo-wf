alias DebugName = pkg::value::DebugName;
alias LocalVariable = pkg::value::LocalVariable;
alias Value = pkg::value::Value;
alias Cell = pkg::value::Cell;
alias Proto = pkg::value::Proto;
alias Script = pkg::value::Script;
alias Heap = pkg::heap::Heap;
alias Frame = pkg::execution::Frame;
alias CallbackPlan = pkg::execution::CallbackPlan;
alias CallbackFrame = pkg::execution::CallbackFrame;
alias LibraryContext = pkg::execution::LibraryContext;
alias SortFrame = pkg::execution::SortFrame;
alias PatternSubFrame = pkg::execution::PatternSubFrame;
alias PendingCall = pkg::execution::PendingCall;
alias CoroutineCall = pkg::execution::CoroutineCall;

public struct Vm {
  public main_thread: u32;
  public current_thread: u32;
  public native_entries: u32;
  public transfer_kind: u8;
  public transfer: CoroutineCall;
  public resume_call: CoroutineCall;
  public yield_call: CoroutineCall;
  public c_depth: u32;
  public pattern_subs: Box<Slots<PatternSubFrame>>;
  public cjson_configs: Box<Slots<CjsonConfig>>;
  public cjson_active_config: u64;
  public library_contexts: Box<Slots<LibraryContext>>;
  public sort_frames: Box<Slots<SortFrame>>;
  public random_state: u64;
  public heap: Heap;
  public frames: Box<Slots<Frame>>;
  public open_upvalues: Box<Slots<u32>>;
  public protos: Box<Slots<Proto>>;
  public lineinfo: Box<Slots<u32>>;
  public source: Box<Slots<u8>>;
  public top: u64;
  public budget: u64;
  public saved_pc: u64;
  public saved_base: u64;
  public saved_kbase: u64;
  public error: Value;
  public activation: u32;
  public globals: u32;
  public type_metatables: Array<u32, 8>;
  public host_stopped: Bool;
  public stopped_stack: Box<Slots<Value>>;
  public callback_plan: CallbackPlan;
  public callbacks: Box<Slots<CallbackFrame>>;
  public suspended: Bool;
  public pending: PendingCall;
  public call_pending: Bool;
  public raise_pc: u64;
  public pcall_field: Box<Slots<u8>>;
  public post_catch: u64;
  public debug_names: Box<Slots<u8>>;
  public local_variables: Box<Slots<LocalVariable>>;
  public upvalue_names: Box<Slots<DebugName>>;
}

public enum Outcome {
  Done(public count: u64);
  Error();
  Budget();
  HostStopped();
  HostCall();
}

public enum HostOutcome {
  Returned(public count: u64);
  Raised();
  Stop();
  Pending();
}

public interface Host<E> {
  fn call(env: &E, vm: &Vm, stack: &Box<Slots<Value>>, func: u64, argc: u64, id: u32) -> r: HostOutcome writes(env), writes(vm), writes(stack) contract {
    ensures stack^.inner.len == entry(stack)^.inner.len;
  };
}

public const protected_flag: u8 = 1_u8;

public const tail_flag: u8 = 2_u8;

public const native_flag: u8 = 4_u8;

public const builtin_pcall: u32 = 0_u32;

public const builtin_error: u32 = 1_u32;

public const builtin_select: u32 = 2_u32;

public const builtin_type: u32 = 3_u32;

public const builtin_rawget: u32 = 4_u32;

public const builtin_rawset: u32 = 5_u32;

public const builtin_setmetatable: u32 = 6_u32;

public const builtin_getmetatable: u32 = 7_u32;

public const unlimited: u64 = 18446744073709551615_u64;

public fn vm_new(limit: u64) -> r: Vm pure doc "A VM with an ordinary globals table and a real main-thread cell whose identity survives reset and start. Installed execution buffers remain in the VM and embedding stack; the cell holds empty counterpart owners. start installs script metadata.";

public fn stack_new(size: u64) -> r: Box<Slots<Value>> pure contract {
  ensures r.inner.len == size;
} doc "Constructs a Nil-filled stack.";

public fn reset(vm: &Vm, stack: &Box<Slots<Value>>) -> r: unit writes(stack), writes(vm) doc "Closes open upvalues and removes active frames.";

public fn start<interface Host<E>>(script: &Script, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, proto: u32, argc: u64, budget: u64) -> r: Outcome reads(script), writes(stack), writes(vm), writes(env) doc "Calls a prototype with arguments at stack[1..1+argc), returning results at slot zero.";

public fn resume<interface Host<E>>(script: &Script, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, budget: u64) -> r: Outcome reads(script), writes(stack), writes(vm), writes(env) doc "Resumes the saved dispatch checkpoint with a fresh budget. While a host call is pending it ends the run with an error instead, and the call can no longer be completed or failed.";

public fn pending_argument(vm: &Vm, stack: &Box<Slots<Value>>, index: u64) -> r: Value reads(vm), reads(stack) doc "Argument index of the host call that a HostCall outcome left pending, or Nil past its argument count or when no call is pending.";

public fn complete_call<interface Host<E>>(script: &Script, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, results: &[Value], budget: u64) -> r: Outcome reads(script), reads(results), writes(stack), writes(vm), writes(env) doc "Returns results from the pending host call, as HostOutcome::Returned would have, and continues with a fresh budget.";

public fn fail_call<interface Host<E>>(script: &Script, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, error: Value, budget: u64) -> r: Outcome reads(script), writes(stack), writes(vm), writes(env) doc "Raises error at the pending host call, as HostOutcome::Raised would have, so an enclosing pcall catches it, and continues with a fresh budget.";

public fn run<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, pc: u64, base: u64, kbase: u64) -> r: Outcome reads(code), reads(consts), writes(stack), writes(vm), writes(env) contract {
  requires pc < code^.inner.len;
  requires base + 256_u64 <= stack^.inner.len;
  requires kbase + 256_u64 <= consts^.inner.len;
} doc "Dispatches instructions from pc, in the frame at base with the prototype's constants at kbase, until the run ends, raises or suspends.";

public struct BuiltinBinding {
  public library: u8;
  public name: Array<u8, 32>;
  public length: u64;
  public id: u32;
}

