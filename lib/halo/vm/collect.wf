alias Value = pkg::value::Value;
alias Heap = pkg::heap::Heap;
alias no_handle = pkg::heap::no_handle;

fn mark_roots(vm: &Vm, consts: &Box<Slots<Value>>) -> r: unit reads(consts), writes(vm) {
  doc "Marks main and current identities, globals, type metatables, cached metamethod names and constants. Every execution, the installed one included, is traced through its thread cell by the heap's one execution marker, so the installed record has no marking of its own.";
  let main = Value::Thread(h: vm^.main_thread);
  pkg::heap::gc_mark(heap: &vm^.heap, v: main);
  if vm^.current_thread != vm^.main_thread {
    let current = Value::Thread(h: vm^.current_thread);
    pkg::heap::gc_mark(heap: &vm^.heap, v: current);
  }
  let g = Value::Tab(h: vm^.globals);
  pkg::heap::gc_mark(heap: &vm^.heap, v: g);
  let i = 0_u64;
  loop {
    if i < 8_u64 {
      let m = vm^.type_metatables[i];
      if m != no_handle {
        let mv = Value::Tab(h: m);
        pkg::heap::gc_mark(heap: &vm^.heap, v: mv);
      }
      set i = i +wrap 1_u64;
    } else {
      break;
    }
  }
  set i = 0_u64;
  loop {
    if i < 17_u64 {
      let name = vm^.metamethod_names[i];
      pkg::heap::gc_mark(heap: &vm^.heap, v: name);
      set i = i +wrap 1_u64;
    } else {
      break;
    }
  }
  set i = 0_u64;
  loop {
    if i < consts^.inner.len {
      let k = consts^.inner[i];
      pkg::heap::gc_mark(heap: &vm^.heap, v: k);
      set i = i +wrap 1_u64;
    } else {
      break;
    }
  }
  return unit;
}

fn park_for_marking(vm: &Vm, stack: &Box<Slots<Value>>) -> r: u64 writes(vm), writes(stack) {
  doc "Saves the installed execution into its thread cell as a coroutine switch does, exchanging buffers with the cell's installed-time counterparts, and returns the stack extent the heap's marker retains. The caller has checked that the installed cell is live: main and current are always marked, so only a main thread whose allocation failed for lack of memory lacks one, and that collection ends with the memory error instead.";
  let installed = vm^.current_thread;
  coroutine_save_scalars(vm: vm, h: installed);
  coroutine_swap_boxes(vm: vm, stack: stack, h: installed);
  let index = cvt::<u32, u64>(installed);
  if index < vm^.heap.threads.inner.len {
    if vm^.heap.threads.inner[index].live {
      return pkg::heap::thread_stack_limit(execution: &vm^.heap.threads.inner[index].payload);
    }
  }
  return stack^.inner.len;
}

fn unpark_after_marking(vm: &Vm, stack: &Box<Slots<Value>>, length: u64) -> r: unit writes(vm), writes(stack) contract {
  ensures stack^.inner.len == length;
} {
  doc "Reinstalls the buffers park_for_marking moved, returning the cell its own counterparts. The saved scalars stay in the cell until the next switch or collection overwrites them; nothing reads them while the thread is installed. The two swaps return the stack box with its length unchanged, but the checker loses a box's proven length across swap, so the closing resize_stack exists only to restate that length for callers' contracts. This is the owner's ruled exception to routing around a Whitefoot gap: it waits on Whitefoot's swap length and capacity fact rule (status-board item coord-wfbl-09-04-rule, under wf-need-halo-coroutines), and its removal is tracked by Halo's item halo-coroutine-swap-workaround.";
  let installed = vm^.current_thread;
  coroutine_swap_boxes(vm: vm, stack: stack, h: installed);
  resize_stack(stack: stack, size: length);
  return unit;
}

fn collect_if_due(vm: &Vm, stack: &Box<Slots<Value>>, consts: &Box<Slots<Value>>) -> r: Bool reads(consts), writes(vm), writes(stack) contract {
  ensures stack^.inner.len == entry(stack)^.inner.len;
} {
  doc "Call sites gate the slow path with the same stress/limit/allocation predicate as heap.gc_due; this check also preserves the helper's standalone behavior. A safepoint: at a loop back-edge or call every live value is in a stack slot or a root, so a due collection parks the installed execution in its thread cell, marks the roots so that the heap traces every execution alike, reinstalls it, clears the stack above the live part as Lua 5.1's traversestack does, and sweeps.";
  let accounted = coroutine_refresh_storage(vm: vm, stack: stack);
  if bnot(accounted) {
    return raise_text(vm: vm, text: &collection_memory_error[0_u64..17_u64]);
  }
  let due = pkg::heap::gc_due(heap: &vm^.heap);
  if bnot(due) {
    return True();
  }
  let installed_index = cvt::<u32, u64>(vm^.current_thread);
  if installed_index >= vm^.heap.threads.inner.len {
    return raise_text(vm: vm, text: &collection_memory_error[0_u64..17_u64]);
  }
  if bnot(vm^.heap.threads.inner[installed_index].live) {
    return raise_text(vm: vm, text: &collection_memory_error[0_u64..17_u64]);
  }
  let length = stack^.inner.len;
  pkg::heap::gc_begin(heap: &vm^.heap);
  let limit = park_for_marking(vm: vm, stack: stack);
  mark_roots(vm: vm, consts: consts);
  pkg::heap::gc_propagate(heap: &vm^.heap);
  unpark_after_marking(vm: vm, stack: stack, length: length);
  let j = limit;
  loop {
    if j < stack^.inner.len {
      set stack^.inner[j] = Value::Nil();
      set j = j +wrap 1_u64;
    } else {
      break;
    }
  }
  let freed = pkg::heap::gc_sweep(heap: &vm^.heap);
  cjson_reclaim(vm: vm);
  if vm^.heap.limit > 0_u64 {
    if vm^.heap.bytes > vm^.heap.limit {
      return raise_text(vm: vm, text: &collection_memory_error[0_u64..17_u64]);
    }
  }
  return True();
}

const collection_memory_error: Array<u8, 17> = "not enough memory";
