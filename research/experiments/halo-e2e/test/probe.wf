alias Engine = halo::embed::Engine;
alias Value = halo::value::Value;
alias Outcome = halo::vm::Outcome;
alias HostOutcome = halo::vm::HostOutcome;
alias Host = halo::vm::Host;
alias Vm = halo::vm::Vm;
alias ExitStatus = std::process::ExitStatus;

struct Probe {
  mode: u8;
  calls: u64;
}

fn probe_call(env: &Probe, vm: &Vm, stack: &Box<Slots<Value>>, func: u64, argc: u64, id: u32) -> r: HostOutcome writes(env), writes(vm), writes(stack) contract {
  ensures stack^.inner.len == entry(stack)^.inner.len;
} {
  set env^.calls = env^.calls +sat 1_u64;
  if env^.mode == 2_u8 {
    return HostOutcome::Stop();
  }
  if env^.mode == 3_u8 {
    return HostOutcome::Pending();
  }
  if env^.mode == 1_u8 {
    set vm^.error = Value::Num(n: 99.0_f64);
    return HostOutcome::Raised();
  }
  if func < stack^.inner.len {
    set stack^.inner[func] = Value::Num(n: 73.0_f64);
  }
  return HostOutcome::Returned(count: 1_u64);
}

binding ProbeHost : Host<Probe> {
  call = probe_call;
}

fn probe_run(engine: &Engine, env: &Probe, script: halo::embed::ScriptId) -> r: Outcome writes(engine), writes(env) {
  let out = halo::embed::start::<ProbeHost>(engine: engine, env: env, script: script, budget: 1_u64);
  return probe_settle(engine: engine, env: env, outcome: out);
}

fn probe_settle(engine: &Engine, env: &Probe, outcome: Outcome) -> r: Outcome writes(engine), writes(env) {
  doc "Resumes budget checkpoints until the run finishes, stops or leaves a host call pending.";
  let out = outcome;
  let steps = 0_u64;
  loop {
    match out {
      Done(..) => {
        return out;
      }
      Error() => {
        return out;
      }
      HostStopped() => {
        return out;
      }
      HostCall() => {
        return out;
      }
      Budget() => {
        if steps > 100_u64 {
          return out;
        }
        set steps = steps + 1_u64;
        set out = halo::embed::resume::<ProbeHost>(engine: engine, env: env, budget: 1_u64);
      }
    }
  }
  return out;
}

fn returned(engine: &Engine, expected: f64) -> r: Bool reads(engine) {
  match halo::embed::result(engine: engine, index: 0_u64) {
    None() => {
    }
    Some(value: v) => {
      match halo::embed::number_of(value: v) {
        Is(x: observed) => {
          return feq(observed, expected);
        }
        Not() => {
        }
      }
    }
  }
  return False();
}

