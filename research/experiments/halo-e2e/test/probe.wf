    }
    Ok(value: id) => {
      set top = id;
    }
  }
  let nested = top;
  let compiled_nested = halo::embed::compile(engine: &engine, chunk_name: &probe_text_4[0_u64..12_u64], source: &pending_nested_source[0_u64..108_u64]);
  match move compiled_nested {
    Err(..) => {
      return 73_u8;
    }
    Ok(value: id) => {
      set nested = id;
    }
  }
  let first = probe_run(engine: &engine, env: &env, script: top);
  let first_code = outcome_code(outcome: first);
  if first_code != 4_u8 {
    return 74_u8;
  }
  match halo::embed::pending_call(engine: &engine) {
    None() => {
      return 75_u8;
    }
    Some(value: call) => {
      if call.id != 4096_u32 {
        return 76_u8;
      }
      if call.argc != 2_u64 {
        return 76_u8;
      }
    }
  }
  let seven = halo::embed::pending_argument(engine: &engine, index: 0_u64);
  match halo::embed::number_of(value: seven) {
    Is(x: observed) => {
      let same = feq(observed, 7.0_f64);
      if bnot(same) {
        return 77_u8;
      }
    }
    Not() => {
      return 77_u8;
    }
  }
  let past = halo::embed::pending_argument(engine: &engine, index: 2_u64);
  let absent = is_nil(v: past);
  if bnot(absent) {
    return 78_u8;
  }
  let answer = Value::Num(n: 41.0_f64);
  let results = array_filled::<Value, 1>(value: answer);
  let completed = halo::embed::complete_call::<ProbeHost>(engine: &engine, env: &env, results: &results[0_u64..1_u64], budget: 1_u64);
  let settled = probe_settle(engine: &engine, env: &env, outcome: completed);
  let settled_code = outcome_code(outcome: settled);
  if settled_code != 0_u8 {
    return 79_u8;
  }
  let sum = returned(engine: &engine, expected: 42.0_f64);
  if bnot(sum) {
    return 80_u8;
  }
  let again = halo::embed::complete_call::<ProbeHost>(engine: &engine, env: &env, results: &results[0_u64..1_u64], budget: 1_u64);
  let again_code = outcome_code(outcome: again);
  if again_code != 1_u8 {
    return 81_u8;
  }
  let inner = probe_run(engine: &engine, env: &env, script: nested);
  let inner_code = outcome_code(outcome: inner);
  if inner_code != 4_u8 {
    return 82_u8;
  }
  match halo::embed::pending_call(engine: &engine) {
    None() => {
      return 83_u8;
    }
    Some(value: call) => {
      if call.argc != 1_u64 {
        return 83_u8;
      }
    }
  }
  let error = halo::embed::intern(engine: &engine, bytes: &pending_error[0_u64..4_u64]);
  let failed = halo::embed::fail_call::<ProbeHost>(engine: &engine, env: &env, error: error, budget: 1_u64);
  let caught = probe_settle(engine: &engine, env: &env, outcome: failed);
  let caught_code = outcome_code(outcome: caught);
  if caught_code != 0_u8 {
    return 84_u8;
  }
  match halo::embed::result(engine: &engine, index: 0_u64) {
    None() => {
      return 85_u8;
    }
    Some(value: v) => {
      match halo::embed::string_of(engine: &engine, value: v) {
        None() => {
          return 85_u8;
        }
        Some(value: view) => {
          if view.length != 5_u64 {
            return 85_u8;
          }
        }
      }
    }
  }
  let refused = probe_run(engine: &engine, env: &env, script: top);
  let refused_code = outcome_code(outcome: refused);
  if refused_code != 4_u8 {
    return 86_u8;
  }
  let resumed = halo::embed::resume::<ProbeHost>(engine: &engine, env: &env, budget: 1_u64);
  let resumed_code = outcome_code(outcome: resumed);
  if resumed_code != 1_u8 {
    return 87_u8;
  }
  let late = halo::embed::complete_call::<ProbeHost>(engine: &engine, env: &env, results: &results[0_u64..1_u64], budget: 1_u64);
  let late_code = outcome_code(outcome: late);
  if late_code != 1_u8 {
    return 88_u8;
  }
  let direct_run = probe_run(engine: &engine, env: &env, script: top);
  let direct_run_code = outcome_code(outcome: direct_run);
  if direct_run_code != 4_u8 {
    return 89_u8;
  }
  let slot = top.slot;
  if slot < engine.scripts.inner.len {
    let direct = halo::vm::resume::<ProbeHost>(script: &engine.scripts.inner[slot], stack: &engine.stack, vm: &engine.vm, env: &env, budget: 1_u64);
    let direct_code = outcome_code(outcome: direct);
    if direct_code != 1_u8 {
      return 90_u8;
    }
    let after = halo::vm::complete_call::<ProbeHost>(script: &engine.scripts.inner[slot], stack: &engine.stack, vm: &engine.vm, env: &env, results: &results[0_u64..1_u64], budget: 1_u64);
    let after_code = outcome_code(outcome: after);
    if after_code != 1_u8 {
      return 91_u8;
    }
  } else {
    return 89_u8;
  }
  let raising = halo::embed::compile(engine: &engine, chunk_name: &probe_text_4[0_u64..12_u64], source: &line_error_source[0_u64..10_u64]);
  match move raising {
    Err(..) => {
      return 92_u8;
    }
    Ok(value: id) => {
      let failed_run = probe_run(engine: &engine, env: &env, script: id);
      let failed_run_code = outcome_code(outcome: failed_run);
      if failed_run_code != 1_u8 {
        return 93_u8;
      }
      let raised_line = halo::embed::error_line(engine: &engine);
      if raised_line != 1_u64 {
        return 94_u8;
      }
      let misused = halo::embed::resume::<ProbeHost>(engine: &engine, env: &env, budget: 1_u64);
      let misused_code = outcome_code(outcome: misused);
      if misused_code != 1_u8 {
        return 95_u8;
      }
      let misused_line = halo::embed::error_line(engine: &engine);
      if misused_line != 0_u64 {
        return 96_u8;
      }
    }
  }
  return 0_u8;
}

fn chunk_probe() -> r: u8 pure {
  doc "A runtime error is located in the chunk name the host compiled the script under, whatever that name is.";
  let engine = halo::embed::new_engine(limit: 67108864_u64);
  let env = Probe(mode: 0_u8, calls: 0_u64);
  let compiled = halo::embed::compile(engine: &engine, chunk_name: &other_chunk[0_u64..6_u64], source: &other_source[0_u64..13_u64]);
  match move compiled {
    Err(..) => {
      return 100_u8;
    }
    Ok(value: id) => {
      let ran = probe_run(engine: &engine, env: &env, script: id);
      match ran {
        Error() => {
        }
        Done(..) => {
          return 101_u8;
        }
        Budget() => {
          return 101_u8;
        }
        HostStopped() => {
          return 101_u8;
        }
        HostCall() => {
          return 101_u8;
        }
      }
      let located = format_matches(engine: &engine, line: 0_u64, want: &other_error[0_u64..13_u64]);
      if bnot(located) {
        return 102_u8;
      }
    }
  }
  let long_name = long_chunk_error(engine: &engine, env: &env, name: &long_equals_chunk[0_u64..71_u64], want: &long_equals_error[0_u64..67_u64]);
  if bnot(long_name) {
    return 103_u8;
  }
  let long_file = long_chunk_error(engine: &engine, env: &env, name: &long_at_chunk[0_u64..71_u64], want: &long_at_error[0_u64..63_u64]);
  if bnot(long_file) {
    return 104_u8;
  }
  return 0_u8;
}

fn result_length(engine: &Engine) -> r: u64 reads(engine) {
  match halo::embed::result(engine: engine, index: 0_u64) {
    None() => {
      return 0_u64;
    }
    Some(value: v) => {
      match halo::embed::string_of(engine: engine, value: v) {
        None() => {
          return 0_u64;
        }
        Some(value: view) => {
          return view.length;
        }
      }
    }
  }
}

fn pcall_field_probe() -> r: u8 pure {
  doc "pcall returns an error table as raised until the embedding names a field, then the string the table holds there.";
  let engine = halo::embed::new_engine(limit: 67108864_u64);
  let env = Probe(mode: 0_u8, calls: 0_u64);
  let compiled = halo::embed::compile(engine: &engine, chunk_name: &probe_text_4[0_u64..12_u64], source: &field_source[0_u64..48_u64]);
  match move compiled {
    Err(..) => {
      return 110_u8;
    }
    Ok(value: id) => {
      let unnamed = probe_run(engine: &engine, env: &env, script: id);
      let unnamed_code = outcome_code(outcome: unnamed);
      if unnamed_code != 0_u8 {
        return 111_u8;
      }
      let table_length = result_length(engine: &engine);
      if table_length != 5_u64 {
        return 112_u8;
      }
      halo::embed::set_pcall_error_field(engine: &engine, field: &field_name[0_u64..3_u64]);
      let named = probe_run(engine: &engine, env: &env, script: id);
      let named_code = outcome_code(outcome: named);
      if named_code != 0_u8 {
        return 113_u8;
      }
      let string_length = result_length(engine: &engine);
      if string_length != 6_u64 {
        return 114_u8;
      }
    }
  }
  return 0_u8;
}

fn long_chunk_error(engine: &Engine, env: &Probe, name: &[u8], want: &[u8]) -> r: Bool reads(name), reads(want), writes(engine), writes(env) {
  doc "Runs error('boom') compiled under name and compares its location with want: runtime locations abbreviate the name as luaO_chunkid does with LUA_IDSIZE 60.";
  let compiled = halo::embed::compile(engine: engine, chunk_name: name, source: &other_source[0_u64..13_u64]);
  match move compiled {
    Err(..) => {
      return False();
    }
    Ok(value: id) => {
      let ran = probe_run(engine: engine, env: env, script: id);
      return format_matches(engine: engine, line: 0_u64, want: want);
    }
  }
}

fn smoke() -> status: ExitStatus pure {
  doc "Runs the embedding lifecycle observations, including cjson reclamation, collection statistics and configurable pause with ordinary and stress collection.";
  let code = embed_probe();
  if code == 0_u8 {
    set code = pending_probe();
  }
  if code == 0_u8 {
    set code = chunk_probe();
  }
  if code == 0_u8 {
    set code = pcall_field_probe();
  }
  if code == 0_u8 {
    let ordinary = False();
    set code = cjson_configs_probe(stress: ordinary);
  }
  if code == 0_u8 {
    let stress = True();
    set code = cjson_configs_probe(stress: stress);
  }
  if code == 0_u8 {
    let ordinary = False();
    set code = gc_stats_probe(stress: ordinary);
  }
  if code == 0_u8 {
    let stress = True();
    set code = gc_stats_probe(stress: stress);
  }
  if code == 0_u8 {
    let ordinary = False();
    set code = gc_pause_probe(stress: ordinary);
  }
  if code == 0_u8 {
    let stress = True();
    set code = gc_pause_probe(stress: stress);
  }
  return std::process::exit_status(code: code);
}

