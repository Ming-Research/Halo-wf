alias Value = halo::value::Value;
alias Vm = halo::vm::Vm;
alias HostOutcome = halo::vm::HostOutcome;
alias Host = halo::vm::Host;
alias num_of = halo::value::num_of;
alias str_of = halo::value::str_of;
alias tab_of = halo::value::tab_of;
alias protected_flag = halo::vm::protected_flag;

struct Env {
  db: Value;
  types: Value;
  expiry: Value;
  error: Bool;
}

fn raw(vm: &Vm, table: Value, key: Value, value: Value) -> r: unit writes(vm) {
  let written_v0 = halo::heap::table_set(heap: &vm^.heap, t: table, key: key, val: value);
  return unit;
}

fn get(vm: &Vm, table: Value, key: Value) -> r: Value reads(vm) {
  return halo::heap::table_get(heap: &vm^.heap, t: table, key: key);
}

fn literal(vm: &Vm, text: &[u8]) -> r: Value reads(text), writes(vm) {
  return halo::heap::intern(heap: &vm^.heap, bytes: text);
}

fn num(x: f64) -> r: Value pure {
  return Value::Num(n: x);
}

fn kind(v: Value) -> r: u8 pure {
  return halo::embed::kind(value: v);
}

fn is_nil(v: Value) -> r: Bool pure {
  let k_v1 = kind(v: v);
  return k_v1 == 0_u8;
}

fn is_string(v: Value) -> r: Bool pure {
  let k_v2 = kind(v: v);
  return k_v2 == 3_u8;
}

fn arg(stack: &Box<Slots<Value>>, func: u64, argc: u64, index: u64) -> r: Value reads(stack) {
  if index < argc {
    let first_v3 = func +sat 1_u64;
    let at_v4 = first_v3 +sat index;
    if at_v4 < stack^.inner.len {
      return stack^.inner[at_v4];
    }
  }
  return Value::Nil();
}

fn whole_integer(x: f64) -> r: Option<i64> pure {
  doc "Redis 7.2.16's double2ll: an integral value no larger in magnitude than LLONG_MAX/2 (2^62 as a double) as its integer, otherwise None. NaN gives None and negative zero gives 0, as in Redis.";
  if flt(x, -4.611686018427388e18_f64) {
    return None<i64>();
  }
  if fgt(x, 4.611686018427388e18_f64) {
    return None<i64>();
  }
  let whole = ftrunc(x);
  if fne(whole, x) {
    return None<i64>();
  }
  if cvt.defined::<f64, i64>(whole) {
    let integer = cvt::<f64, i64>(whole);
    return Some<i64>(value: integer);
  }
  return None<i64>();
}

fn fallback_text(vm: &Vm, x: f64) -> r: Value writes(vm) {
  doc "Stands in for Redis 7.2.16's fpconv_dtoa, which writes a minus sign for a set sign bit, then 0, nan or inf for those values and otherwise the shortest digits that read back exactly. This writes Lua's %.14g text: the sign, zero, nan and inf agree, finite digits can differ (0.1 agrees, 1/3 does not). Whitefoot's standard library cannot write shortest round-trip digits yet: board item wf-need-halo-oracle-72.";
  let bytes = array_filled::<u8, 32>(value: 0_u8);
  let count = halo::number::format_number(value: x, out: &bytes[0_u64..32_u64]);
  return literal(vm: vm, text: &bytes[0_u64..count]);
}

fn argument_text(vm: &Vm, x: f64) -> r: Value writes(vm) {
  doc "The text a Lua number becomes as a redis.call argument, after Redis 7.2.16's luaArgsToRedisArgv: an integer when double2ll accepts it, otherwise fpconv_dtoa, whose finite digits wait on wf-need-halo-oracle-72 (see fallback_text).";
  match whole_integer(x: x) {
    Some(value: integer) => {
      return integer_string(vm: vm, value: integer);
    }
    None() => {
    }
  }
  return fallback_text(vm: vm, x: x);
}

fn double_text(vm: &Vm, x: f64) -> r: Value writes(vm) {
  doc "A RESP2 double reply's text, after Redis 7.2.16's d2string: nan for every NaN; inf, -inf, 0 and -0 as fpconv_dtoa writes them; an integer when double2ll accepts it; otherwise fpconv_dtoa, whose finite digits wait on wf-need-halo-oracle-72 (see fallback_text).";
  if fne(x, x) {
    return literal(vm: vm, text: &nan_word[0_u64..3_u64]);
  }
  let zero = feq(x, 0.0_f64);
  let magnitude = fabs(x);
  let infinite = fgt(magnitude, 1.7976931348623157e308_f64);
  if bor(zero, infinite) {
    return fallback_text(vm: vm, x: x);
  }
  return argument_text(vm: vm, x: x);
}

fn incrbyfloat_text(vm: &Vm, x: f64) -> r: Value writes(vm) {
  doc "Stands in for the value INCRBYFLOAT stores and replies. Redis 7.2.16 adds in long double and writes the sum with ld2string's human mode: %.17Lf with trailing zeros and a trailing point removed, -0 written 0. This adds in double and writes the argument text: when both precisions give the same integral sum within double2ll's range the digits agree; other sums can differ (0 + 0.1 agrees as 0.1; 1e17 + 1 does not, since long double keeps the 1). Exact text needs long double arithmetic and fixed-point digits, beyond the shortest-digit conversion of board item wf-need-halo-oracle-72.";
  return argument_text(vm: vm, x: x);
}

fn lua_string(vm: &Vm, v: Value) -> r: Value writes(vm) {
  doc "lua_tolstring's conversion, as redis.sha1hex reads its argument: a number becomes Lua's %.14g text, anything else is returned unchanged.";
  match num_of(v: v) {
    Is(x: lua_number) => {
      let digits = array_filled::<u8, 32>(value: 0_u8);
      let written = halo::number::format_number(value: lua_number, out: &digits[0_u64..32_u64]);
      return literal(vm: vm, text: &digits[0_u64..written]);
    }
    Not() => {
      return v;
    }
  }
}

fn string_arg(vm: &Vm, v: Value) -> r: Value writes(vm) {
  doc "A redis.call argument as the command receives it: a number in Redis 7.2.16's argument text, a string unchanged.";
  match num_of(v: v) {
    Is(x: n_v5) => {
      return argument_text(vm: vm, x: n_v5);
    }
    Not() => {
      return v;
    }
  }
}

fn space_byte(b: u8) -> r: Bool pure {
  doc "C isspace in the C locale: space, tab, line feed, vertical tab, form feed, carriage return.";
  if b == 32_u8 {
    return True();
  }
  let low = b >= 9_u8;
  let high = b <= 13_u8;
  return band(low, high);
}

fn float_value(vm: &Vm, v: Value) -> r: Option<f64> reads(vm) {
  doc "Redis 7.2.16's string2ld as INCRBYFLOAT reads its operands: strtold syntax over the whole string, refusing an empty string, a NUL, leading or trailing whitespace and NaN. Two differences remain: Redis reads into long double, this into a double, and so also accepts values past the double range as infinities that Redis refuses or keeps.";
  match halo::heap::string_of(heap: &vm^.heap, value: v) {
    None() => {
    }
    Some(value: view) => {
      let h = cvt::<u32, u64>(view.handle);
      if h < vm^.heap.strings.inner.len {
        let n = vm^.heap.strings.inner[h].payload.bytes.inner.len;
        if n > 0_u64 {
          for (i in 0_u64..n) {
            if i < vm^.heap.strings.inner[h].payload.bytes.inner.len {
              if vm^.heap.strings.inner[h].payload.bytes.inner[i] == 0_u8 {
                return None<f64>();
              }
            }
          }
          let first = vm^.heap.strings.inner[h].payload.bytes.inner[0_u64];
          let last_at = n - 1_u64;
          let last = vm^.heap.strings.inner[h].payload.bytes.inner[last_at];
          let leading = space_byte(b: first);
          let trailing = space_byte(b: last);
          if bor(leading, trailing) {
            return None<f64>();
          }
          match halo::number::str2number(bytes: &vm^.heap.strings.inner[h].payload.bytes.inner[0_u64..n]) {
            Some(value: x) => {
              if feq(x, x) {
                return Some<f64>(value: x);
              }
            }
            None() => {
            }
          }
        }
      }
    }
  }
  return None<f64>();
}

fn member_less(vm: &Vm, a: Value, b: Value) -> r: Bool reads(vm) {
  doc "Byte order of two sorted-set members, as Redis's sdscmp: the first differing byte, then the shorter first.";
  match halo::heap::string_of(heap: &vm^.heap, value: a) {
    None() => {
    }
    Some(value: view_a) => {
      match halo::heap::string_of(heap: &vm^.heap, value: b) {
        None() => {
        }
        Some(value: view_b) => {
          let ha = cvt::<u32, u64>(view_a.handle);
          let hb = cvt::<u32, u64>(view_b.handle);
          if ha < vm^.heap.strings.inner.len {
            if hb < vm^.heap.strings.inner.len {
              let na = vm^.heap.strings.inner[ha].payload.bytes.inner.len;
              let nb = vm^.heap.strings.inner[hb].payload.bytes.inner.len;
              let shorter = imin(na, nb);
              for (i in 0_u64..shorter) {
                if i < vm^.heap.strings.inner[ha].payload.bytes.inner.len {
                  if i < vm^.heap.strings.inner[hb].payload.bytes.inner.len {
                    let ba = vm^.heap.strings.inner[ha].payload.bytes.inner[i];
                    let bb = vm^.heap.strings.inner[hb].payload.bytes.inner[i];
                    if ba != bb {
                      return ba < bb;
                    }
                  }
                }
              }
              return na < nb;
            }
          }
        }
      }
    }
  }
  return False();
}

fn zset_before(vm: &Vm, table: Value, a: Value, b: Value) -> r: Bool reads(vm) {
  doc "Sorted-set order: the lower score first, then the lower member in byte order.";
  let va = get(vm: vm, table: table, key: a);
  let vb = get(vm: vm, table: table, key: b);
  let sa = number(vm: vm, v: va);
  let sb = number(vm: vm, v: vb);
  if flt(sa, sb) {
    return True();
  }
  if flt(sb, sa) {
    return False();
  }
  return member_less(vm: vm, a: a, b: b);
}

fn sort_members(vm: &Vm, table: Value, members: &Box<Slots<Value>>) -> r: unit reads(vm), writes(members) {
  doc "Insertion sort of a sorted set's members into sorted-set order.";
  let count = members^.inner.len;
  if count < 2_u64 {
    return unit;
  }
  for (i in 1_u64..count) {
    let j = i;
    loop {
      if j == 0_u64 {
        break;
      }
      let prev = j - 1_u64;
      if j >= members^.inner.len {
        break;
      }
      let left = members^.inner[prev];
      let right = members^.inner[j];
      if zset_before(vm: vm, table: table, a: right, b: left) {
        set members^.inner[prev] = right;
        set members^.inner[j] = left;
        set j = prev;
      } else {
        break;
      }
    }
  }
  return unit;
}

fn reply_arguments_valid(argc: u64, v: Value) -> r: Bool pure {
  doc "redis.error_reply and redis.status_reply take exactly one argument of string type (lua_type, so a number is refused).";
  if argc != 1_u64 {
    return False();
  }
  return is_string(v: v);
}

fn error_reply_table(vm: &Vm, argc: u64, v: Value) -> r: Value writes(vm) {
  doc "Redis 7.2.16's redis.error_reply: with wrong arguments, the error table for ERR wrong number or type of arguments; otherwise luaPushErrorBuff of the string with a leading minus sign ensured. The text ends at its first NUL; after one leading minus sign, the bytes before the first space are the error code and the rest the message, or ERR is the code and all of it the message when there is no space; the message loses carriage returns and line feeds at both ends; the err field is the code, a space and the message.";
  let valid = reply_arguments_valid(argc: argc, v: v);
  if bnot(valid) {
    let refusal = literal(vm: vm, text: &reply_arguments[0_u64..37_u64]);
    return reply_table(vm: vm, field: &s_30[0_u64..3_u64], v: refusal);
  }
  let text = box_slots_new::<u8>(capacity: 0_u64);
  value_bytes(vm: vm, v: v, out: &text);
  let n = text.inner.len;
  let end = n;
  for (i in 0_u64..n) {
    if i < text.inner.len {
      if text.inner[i] == 0_u8 {
        set end = i;
        break;
      }
    }
  }
  let start = 0_u64;
  if end > 0_u64 {
    if text.inner.len > 0_u64 {
      if text.inner[0_u64] == 45_u8 {
        set start = 1_u64;
      }
    }
  }
  let space = end;
  for (j in start..end) {
    if j < text.inner.len {
      if text.inner[j] == 32_u8 {
        set space = j;
        break;
      }
    }
  }
  let out = box_slots_new::<u8>(capacity: 0_u64);
  let first = start;
  if space < end {
    if start <= space {
      if space <= text.inner.len {
        text_bytes(out: &out, bytes: &text.inner[start..space]);
      }
    }
    push(out: &out, byte: 32_u8);
    set first = space +sat 1_u64;
  } else {
    text_bytes(out: &out, bytes: &redis_err[0_u64..4_u64]);
  }
  let last = end;
  loop {
    if first >= last {
      break;
    }
    if first >= text.inner.len {
      break;
    }
    let lead = text.inner[first];
    let lead_cr = lead == 13_u8;
    let lead_lf = lead == 10_u8;
    if bor(lead_cr, lead_lf) {
      set first = first +sat 1_u64;
    } else {
      break;
    }
  }
  loop {
    if last <= first {
      break;
    }
    let before = last - 1_u64;
    if before >= text.inner.len {
      break;
    }
    let tail = text.inner[before];
    let tail_cr = tail == 13_u8;
    let tail_lf = tail == 10_u8;
    if bor(tail_cr, tail_lf) {
      set last = before;
    } else {
      break;
    }
  }
  if first < last {
    if last <= text.inner.len {
      text_bytes(out: &out, bytes: &text.inner[first..last]);
    }
  }
  let count = out.inner.len;
  let message = literal(vm: vm, text: &out.inner[0_u64..count]);
  return reply_table(vm: vm, field: &s_30[0_u64..3_u64], v: message);
}

fn status_reply_table(vm: &Vm, argc: u64, v: Value) -> r: Value writes(vm) {
  doc "Redis 7.2.16's redis.status_reply: the error table for ERR wrong number or type of arguments, or a table whose ok field is the string unchanged.";
  let valid = reply_arguments_valid(argc: argc, v: v);
  if bnot(valid) {
    let refusal = literal(vm: vm, text: &reply_arguments[0_u64..37_u64]);
    return reply_table(vm: vm, field: &s_30[0_u64..3_u64], v: refusal);
  }
  return reply_table(vm: vm, field: &s_5[0_u64..2_u64], v: v);
}

fn number(vm: &Vm, v: Value) -> r: f64 reads(vm) {
  match num_of(v: v) {
    Is(x: n_v8) => {
      return n_v8;
    }
    Not() => {
    }
  }
  match halo::heap::string_of(heap: &vm^.heap, value: v) {
    None() => {
    }
    Some(value: view_v9) => {
      let h_v10 = cvt::<u32, u64>(view_v9.handle);
      if h_v10 < vm^.heap.strings.inner.len {
        let n_v11 = vm^.heap.strings.inner[h_v10].payload.bytes.inner.len;
        match halo::number::str2number(bytes: &vm^.heap.strings.inner[h_v10].payload.bytes.inner[0_u64..n_v11]) {
          Some(value: x_v12) => {
            return x_v12;
          }
          None() => {
          }
        }
      }
    }
  }
  return 0.0_f64;
}

fn equals_text(vm: &Vm, value: Value, text: &[u8]) -> r: Bool reads(vm), reads(text) {
  match halo::heap::string_of(heap: &vm^.heap, value: value) {
    None() => {
      return False();
    }
    Some(value: view_v13) => {
      let h_v14 = cvt::<u32, u64>(view_v13.handle);
      if h_v14 < vm^.heap.strings.inner.len {
        if vm^.heap.strings.inner[h_v14].payload.bytes.inner.len == text^.len {
          for (i_v15 in 0_u64..text^.len) {
            if i_v15 < vm^.heap.strings.inner[h_v14].payload.bytes.inner.len {
              let b_v16 = vm^.heap.strings.inner[h_v14].payload.bytes.inner[i_v15];
              if b_v16 >= 97_u8 {
                if b_v16 <= 122_u8 {
                  set b_v16 = b_v16 - 32_u8;
                }
              }
              if b_v16 != text^[i_v15] {
                return False();
              }
            } else {
              return False();
            }
          }
          return True();
        }
      }
    }
  }
  return False();
}

fn reply_table(vm: &Vm, field: &[u8], v: Value) -> r: Value reads(field), writes(vm) {
  let t_v17 = halo::heap::new_table(heap: &vm^.heap, asize: 0_u32, hsize: 1_u32);
  let key_v18 = literal(vm: vm, text: field);
  raw(vm: vm, table: t_v17, key: key_v18, value: v);
  return t_v17;
}

fn fail(env: &Env, vm: &Vm, text: &[u8]) -> r: Value reads(text), writes(env), writes(vm) {
  set env^.error = True();
  return literal(vm: vm, text: text);
}

fn wrong_args(env: &Env, vm: &Vm) -> r: Value writes(env), writes(vm) {
  return fail(env: env, vm: vm, text: &s_0[0_u64..58_u64]);
}

fn wrong_type(env: &Env, vm: &Vm) -> r: Value writes(env), writes(vm) {
  return fail(env: env, vm: vm, text: &s_1[0_u64..65_u64]);
}

fn type_is(vm: &Vm, types: Value, key: Value, expected: f64) -> r: Bool reads(vm) {
  let t_v19 = get(vm: vm, table: types, key: key);
  match num_of(v: t_v19) {
    Is(x: x_v20) => {
      return feq(x_v20, expected);
    }
    Not() => {
      return True();
    }
  }
}

fn set_kind(env: &Env, vm: &Vm, key: Value, k: f64) -> r: unit reads(env), writes(vm) {
  let v_v21 = num(x: k);
  raw(vm: vm, table: env^.types, key: key, value: v_v21);
  return unit;
}

fn erase(env: &Env, vm: &Vm, key: Value) -> r: unit reads(env), writes(vm) {
  let nil_v22 = Value::Nil();
  raw(vm: vm, table: env^.db, key: key, value: nil_v22);
  raw(vm: vm, table: env^.types, key: key, value: nil_v22);
  raw(vm: vm, table: env^.expiry, key: key, value: nil_v22);
  return unit;
}

fn table_count(vm: &Vm, table: Value) -> r: u64 reads(vm) {
  let key_v23 = Value::Nil();
  let count_v24 = 0_u64;
  loop {
    match halo::heap::table_next(heap: &vm^.heap, t: table, key: key_v23) {
      Err(..) => {
        break;
      }
      Ok(value: opt_v25) => {
        match opt_v25 {
          None() => {
            break;
          }
          Some(value: pair_v26) => {
            set key_v23 = pair_v26.key;
            set count_v24 = count_v24 +sat 1_u64;
          }
        }
      }
    }
  }
  return count_v24;
}

fn integer_string(vm: &Vm, value: i64) -> r: Value writes(vm) {
  let bytes_v27 = box_slots_new::<u8>(capacity: 0_u64);
  if value < 0_i64 {
    push(out: &bytes_v27, byte: 45_u8);
  }
  let mag_v28 = 0_u64;
  if value < 0_i64 {
    let next_v29 = value + 1_i64;
    let neg_v30 = 0_i64 - next_v29;
    let unsigned_v31 = cvt::<i64, u64>(neg_v30);
    set mag_v28 = unsigned_v31 + 1_u64;
  } else {
    set mag_v28 = cvt::<i64, u64>(value);
  }
  decimal(out: &bytes_v27, n: mag_v28);
  let n_v32 = bytes_v27.inner.len;
  return literal(vm: vm, text: &bytes_v27.inner[0_u64..n_v32]);
}

fn parse_integer(vm: &Vm, value: Value) -> r: Option<i64> reads(vm) {
  match halo::heap::string_of(heap: &vm^.heap, value: value) {
    None() => {
    }
    Some(value: view_v33) => {
      let h_v34 = cvt::<u32, u64>(view_v33.handle);
      if h_v34 < vm^.heap.strings.inner.len {
        let len_v35 = vm^.heap.strings.inner[h_v34].payload.bytes.inner.len;
        if len_v35 > 0_u64 {
          let neg_v36 = False();
          let start_v37 = 0_u64;
          if vm^.heap.strings.inner[h_v34].payload.bytes.inner[0_u64] == 45_u8 {
            set neg_v36 = True();
            set start_v37 = 1_u64;
          }
          if start_v37 == len_v35 {
            return None<i64>();
          }
          let n_v38 = 0_u64;
          for (i_v39 in start_v37..len_v35) {
            if i_v39 < vm^.heap.strings.inner[h_v34].payload.bytes.inner.len {
              let b_v40 = vm^.heap.strings.inner[h_v34].payload.bytes.inner[i_v39];
              if b_v40 < 48_u8 {
                return None<i64>();
              }
              if b_v40 > 57_u8 {
                return None<i64>();
              }
              let digit_v41 = b_v40 - 48_u8;
              let d_v42 = cvt::<u8, u64>(digit_v41);
              if n_v38 > 922337203685477580_u64 {
                return None<i64>();
              }
              let tens_v43 = n_v38 * 10_u64;
              let next_v44 = tens_v43 + d_v42;
              let max_v45 = 9223372036854775807_u64;
              if neg_v36 {
                set max_v45 = 9223372036854775808_u64;
              }
              if next_v44 > max_v45 {
                return None<i64>();
              }
              set n_v38 = next_v44;
            } else {
              return None<i64>();
            }
          }
          if neg_v36 {
            if n_v38 == 9223372036854775808_u64 {
              return Some<i64>(value: -9223372036854775808_i64);
            }
            if n_v38 <= 9223372036854775807_u64 {
              let v_v46 = cvt::<u64, i64>(n_v38);
              let r_v47 = 0_i64 - v_v46;
              return Some<i64>(value: r_v47);
            }
          } else if n_v38 <= 9223372036854775807_u64 {
            let v_v48 = cvt::<u64, i64>(n_v38);
            return Some<i64>(value: v_v48);
          }
        }
      }
    }
  }
  return None<i64>();
}

fn command(env: &Env, vm: &Vm, stack: &Box<Slots<Value>>, func: u64, argc: u64) -> r: Value reads(stack), writes(env), writes(vm) {
  set env^.error = False();
  let cmd_v49 = arg(stack: stack, func: func, argc: argc, index: 0_u64);
  for (i_v50 in 0_u64..argc) {
    let a_v51 = arg(stack: stack, func: func, argc: argc, index: i_v50);
    let k_v52 = kind(v: a_v51);
