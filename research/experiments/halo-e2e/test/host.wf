fn host_call(env: &Env, vm: &Vm, stack: &Box<Slots<Value>>, func: u64, argc: u64, id: u32) -> r: HostOutcome reads(stack), writes(vm), writes(stack.inner[func]) contract {
  ensures stack^.inner.len == entry(stack)^.inner.len;
} {
  if id == 4102_u32 {
    if argc != 1_u64 {
      let message = literal(vm: vm, text: &sha_arity[0_u64..29_u64]);
      let error = reply_table(vm: vm, field: &s_30[0_u64..3_u64], v: message);
      set vm^.error = error;
      return HostOutcome::Raised();
    }
    let input = arg(stack: stack, func: func, argc: argc, index: 0_u64);
    let coerced = lua_string(vm: vm, v: input);
    let bytes = box_slots_new::<u8>(capacity: 0_u64);
    value_bytes(vm: vm, v: coerced, out: &bytes);
    let n = bytes.inner.len;
    let digest = halo::embed::sha1hex(bytes: &bytes.inner[0_u64..n]);
    let value = literal(vm: vm, text: &digest[0_u64..40_u64]);
    if func < stack^.inner.len {
      set stack^.inner[func] = value;
    }
    return HostOutcome::Returned(count: 1_u64);
  }
  if id == 4100_u32 {
    return HostOutcome::Returned(count: 0_u64);
  }
  if id == 4103_u32 {
    if argc != 1_u64 {
      let repl_arity = literal(vm: vm, text: &set_repl_arity[0_u64..43_u64]);
      let arity_error = reply_table(vm: vm, field: &s_30[0_u64..3_u64], v: repl_arity);
      set vm^.error = arity_error;
      return HostOutcome::Raised();
    }
    let flag_value = arg(stack: stack, func: func, argc: argc, index: 0_u64);
    let flag_number = number(vm: vm, v: flag_value);
    let flag_whole = ftrunc(flag_number);
    let flag_low = fle(0.0_f64, flag_whole);
    let flag_high = fle(flag_whole, 3.0_f64);
    let flag_valid = band(flag_low, flag_high);
    if bnot(flag_valid) {
      let repl_flags = literal(vm: vm, text: &set_repl_flags[0_u64..81_u64]);
      let flags_error = reply_table(vm: vm, field: &s_30[0_u64..3_u64], v: repl_flags);
      set vm^.error = flags_error;
      return HostOutcome::Raised();
    }
    return HostOutcome::Returned(count: 0_u64);
  }
  if id == 4101_u32 {
    let name_v212 = arg(stack: stack, func: func, argc: argc, index: 1_u64);
    let text_v213 = box_slots_new::<u8>(capacity: 0_u64);
    let line = callback_line(vm: vm);
    if line > 0_u64 {
      text_bytes(out: &text_v213, bytes: &lua_source[0_u64..12_u64]);
      decimal(out: &text_v213, n: line);
      push(out: &text_v213, byte: 58_u8);
      push(out: &text_v213, byte: 32_u8);
    }
    text_bytes(out: &text_v213, bytes: &s_29[0_u64..56_u64]);
    value_bytes(vm: vm, v: name_v212, out: &text_v213);
    push(out: &text_v213, byte: 39_u8);
    let len_v214 = text_v213.inner.len;
    let e_v215 = literal(vm: vm, text: &text_v213.inner[0_u64..len_v214]);
    set vm^.error = e_v215;
    return HostOutcome::Raised();
  }
  let call_v217 = id == 4096_u32;
  let protected_v218 = id == 4097_u32;
  if bor(call_v217, protected_v218) {
    return HostOutcome::Pending();
  }
  let value_v216 = Value::Nil();
  let v_v220 = arg(stack: stack, func: func, argc: argc, index: 0_u64);
  if id == 4098_u32 {
    set value_v216 = status_reply_table(vm: vm, argc: argc, v: v_v220);
  } else if id == 4099_u32 {
    set value_v216 = error_reply_table(vm: vm, argc: argc, v: v_v220);
