alias Inputs = std::process::Inputs;
alias ExitStatus = std::process::ExitStatus;

public fn main(inputs: Inputs) -> status: ExitStatus pure waits doc "Runs one oracle script with a Whitefoot Redis test host and prints typed RESP2 JSON. With --double-text it instead reads 8-byte little-endian binary64 bit patterns from stdin and prints, for each, its RESP2 double reply text, a tab and its redis.call argument text on one line.";

public fn smoke() -> status: ExitStatus pure doc "Checks embedding lifecycle, budget continuation, host outcomes and collector root retention and release.";
