public fn f(inputs: Inputs) -> status: ExitStatus pure waits doc "Prints forced-collection memory samples for f.";

public fn compile_only(inputs: Inputs) -> status: ExitStatus pure waits doc "Prints forced-collection memory samples for compile_only.";

public fn reset_only(inputs: Inputs) -> status: ExitStatus pure waits doc "Prints forced-collection memory samples for reset_only.";

public fn args_only(inputs: Inputs) -> status: ExitStatus pure waits doc "Prints forced-collection memory samples for args_only.";

