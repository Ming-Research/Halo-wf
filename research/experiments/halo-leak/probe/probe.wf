fn b(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Measures the b embedding variant in a fresh process.";
  return leak_main(inputs: move inputs, name: &leak_name_b[0_u64..1_u64], mode: 1_u8);
}

