fn held(meter: &std::process::MemoryMeter, capacity: u64) -> bytes: u64 writes(meter) {
  doc "Returns the heap growth while one Box<Slots<u64>> of the given capacity is live.";
  let before = std::process::heap_in_use(meter: meter);
  let window = box_slots_new::<u64>(capacity: capacity);
  let during = std::process::heap_in_use(meter: meter);
  let kept = window.inner.cap;
  if kept != capacity {
    return 18446744073709551615_u64;
  }
  return during -sat before;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "Exits 0 when an empty Box<Slots<u64>> holds no heap, 1 when it holds some, and 2 when a one-element box holds none (the meter missed it).";
  let std::process::Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let one = held(meter: &meter, capacity: 1_u64);
  if one == 0_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  let empty = held(meter: &meter, capacity: 0_u64);
  if empty != 0_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
