fn box_exchange(active: &Box<Slots<u64>>, saved: &Box<Slots<u64>>) -> r: unit writes(active), writes(saved) {
  swap(first: active, second: saved);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let active = box_slots_new::<u64>(capacity: 1_u64);
  place_back(window: &active.inner, value: 11_u64);
  let saved = box_slots_new::<u64>(capacity: 2_u64);
  place_back(window: &saved.inner, value: 22_u64);
  place_back(window: &saved.inner, value: 33_u64);
  box_exchange(active: &active, saved: &saved);
  if active.inner.len != 2_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if active.inner.cap != 2_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if saved.inner.len != 1_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  if saved.inner.cap != 1_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  if active.inner[0_u64] != 22_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  if active.inner[1_u64] != 33_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  if saved.inner[0_u64] != 11_u64 {
    return std::process::exit_status(code: 7_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
