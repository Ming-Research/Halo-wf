enum Cell {
  Hot();
  Switch();
  Done();
}

struct Cursor {
  pc: u64;
  base: u64;
  kbase: u64;
}

struct State {
  saved_stack: Box<Slots<u64>>;
  saved_pc: u64;
  saved_base: u64;
  saved_kbase: u64;
}

struct Environment {
  checksum: u64;
  steps: u64;
}

fn checked_cursor(code: &Box<Slots<Cell>>, consts: &Box<Slots<u64>>, stack: &Box<Slots<u64>>, cursor: Cursor) -> r: Option<Cursor> reads(code), reads(consts), reads(stack) contract {
  ensures when Some(value: next): next.pc < code^.inner.len;
  ensures when Some(value: next): next.base + 256_u64 <= stack^.inner.len;
  ensures when Some(value: next): next.kbase + 256_u64 <= consts^.inner.len;
} {
  if cursor.base <= 18446744073709551359_u64 {
    let frame_end = cursor.base + 256_u64;
    if frame_end <= stack^.inner.len {
      if cursor.kbase <= 18446744073709551359_u64 {
        let constants_end = cursor.kbase + 256_u64;
        if constants_end <= consts^.inner.len {
          if cursor.pc < code^.inner.len {
            return Some<Cursor>(value: cursor);
          }
        }
      }
    }
  }
  return None<Cursor>();
}

fn dispatch_exchange(code: &Box<Slots<Cell>>, consts: &Box<Slots<u64>>, stack: &Box<Slots<u64>>, state: &State, env: &Environment, pc: u64, base: u64, kbase: u64) -> r: Bool reads(code), reads(consts), writes(stack), writes(state), writes(env) contract {
  requires pc < code^.inner.len;
  requires base + 256_u64 <= stack^.inner.len;
  requires kbase + 256_u64 <= consts^.inner.len;
} {
  loop (
    invariant fetch: pc < code^.inner.len,
    invariant frame: base + 256_u64 <= stack^.inner.len,
    invariant constants: kbase + 256_u64 <= consts^.inner.len
  ) {
    set env^.steps = env^.steps +sat 1_u64;
    match code^.inner[pc] {
      Hot() => {
        let value = stack^.inner[base] +wrap consts^.inner[kbase];
        set stack^.inner[base] = value;
        set env^.checksum = env^.checksum +wrap value;
        let next = pc +sat 1_u64;
        if next < code^.inner.len {
          set pc = next;
          continue;
        }
        return False();
      }
      Switch() => {
        let next_pc = state^.saved_pc;
        let next_base = state^.saved_base;
        let next_kbase = state^.saved_kbase;
        set state^.saved_pc = pc +sat 1_u64;
        set state^.saved_base = base;
        set state^.saved_kbase = kbase;
        swap(first: stack, second: &state^.saved_stack);
        let received = Cursor(pc: next_pc, base: next_base, kbase: next_kbase);
        let checked = checked_cursor(code: code, consts: consts, stack: stack, cursor: received);
        match checked {
          Some(value: next) => {
            set pc = next.pc;
            set base = next.base;
            set kbase = next.kbase;
            continue;
          }
          None() => {
            return False();
          }
        }
      }
      Done() => {
        return True();
      }
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  let code = box_slots_new::<Cell>(capacity: 6_u64);
  let active_hot = Cell::Hot();
  place_back(window: &code.inner, value: active_hot);
  let active_switch = Cell::Switch();
  place_back(window: &code.inner, value: active_switch);
  let active_done = Cell::Done();
  place_back(window: &code.inner, value: active_done);
  let saved_hot = Cell::Hot();
  place_back(window: &code.inner, value: saved_hot);
  let saved_switch = Cell::Switch();
  place_back(window: &code.inner, value: saved_switch);
  let saved_done = Cell::Done();
  place_back(window: &code.inner, value: saved_done);
  let consts = box_slots_new::<u64>(capacity: 257_u64);
  let stack = box_slots_new::<u64>(capacity: 256_u64);
  let saved = box_slots_new::<u64>(capacity: 257_u64);
  for (i in 0_u64..257_u64) {
    if consts.inner.len < consts.inner.cap {
      place_back(window: &consts.inner, value: 5_u64);
    }
    if stack.inner.len < stack.inner.cap {
      place_back(window: &stack.inner, value: 10_u64);
    }
    if saved.inner.len < saved.inner.cap {
      place_back(window: &saved.inner, value: 20_u64);
    }
  }
  if consts.inner.len != 257_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if stack.inner.len != 256_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if saved.inner.len != 257_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  set consts.inner[0_u64] = 3_u64;
  let state = State(saved_stack: move saved, saved_pc: 3_u64, saved_base: 1_u64, saved_kbase: 1_u64);
  let env = Environment(checksum: 0_u64, steps: 0_u64);
  let completed = dispatch_exchange(code: &code, consts: &consts, stack: &stack, state: &state, env: &env, pc: 0_u64, base: 0_u64, kbase: 0_u64);
  if bnot(completed) {
    return std::process::exit_status(code: 4_u8);
  }
  if env.checksum != 38_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  if env.steps != 5_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  if stack.inner.len != 256_u64 {
    return std::process::exit_status(code: 7_u8);
  }
  if stack.inner[0_u64] != 13_u64 {
    return std::process::exit_status(code: 8_u8);
  }
  if state.saved_stack.inner.len != 257_u64 {
    return std::process::exit_status(code: 9_u8);
  }
  if state.saved_stack.inner[1_u64] != 25_u64 {
    return std::process::exit_status(code: 10_u8);
  }
  if state.saved_pc != 5_u64 {
    return std::process::exit_status(code: 11_u8);
  }
  if state.saved_base != 1_u64 {
    return std::process::exit_status(code: 12_u8);
  }
  if state.saved_kbase != 1_u64 {
    return std::process::exit_status(code: 13_u8);
  }
  set state.saved_pc = 6_u64;
  set env.steps = 0_u64;
  let rejected = dispatch_exchange(code: &code, consts: &consts, stack: &stack, state: &state, env: &env, pc: 1_u64, base: 0_u64, kbase: 0_u64);
  if rejected {
    return std::process::exit_status(code: 14_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
