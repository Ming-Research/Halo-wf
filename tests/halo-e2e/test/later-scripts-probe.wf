alias Engine = halo::embed::Engine;
alias Outcome = halo::vm::Outcome;
alias ScriptId = halo::embed::ScriptId;

fn lp_settle(engine: &Engine, env: &Probe, outcome: Outcome, quota: u64) -> r: Outcome writes(engine), writes(env) {
  doc "Resumes budget checkpoints, each with the given quota, until the run finishes, stops or leaves a host call pending; 200000 resumes bound a stuck run.";
  let out = outcome;
  let resumes = 0_u64;
  loop {
    match out {
      Done(..) => {
        return out;
      }
      Error() => {
        return out;
      }
      HostStopped() => {
        return out;
      }
      HostCall() => {
        return out;
      }
      Budget() => {
        if resumes > 200000_u64 {
          return out;
        }
        set resumes = resumes + 1_u64;
        set out = halo::embed::resume::<ProbeHost>(engine: engine, env: env, budget: quota);
      }
    }
  }
}

fn lp_run(engine: &Engine, env: &Probe, id: ScriptId, quota: u64) -> r: u8 writes(engine), writes(env) {
  doc "Starts a compiled script and settles it; gives the outcome code of probe.wf.";
  let out = halo::embed::start::<ProbeHost>(engine: engine, env: env, script: id, budget: quota);
  let settled = lp_settle(engine: engine, env: env, outcome: out, quota: quota);
  return outcome_code(outcome: settled);
}

fn lp_id(engine: &Engine, chunk: &[u8], source: &[u8]) -> r: ScriptId reads(chunk), reads(source), writes(engine) {
  doc "Compiles and gives the id, or an id of a generation that never exists when the compiler refuses the source.";
  match compile_chunk(engine: engine, chunk: chunk, source: source) {
    None() => {
      return ScriptId(slot: 0_u64, generation: 18446744073709551615_u64);
    }
    Some(value: id) => {
      return id;
    }
  }
}

fn lp_expect(engine: &Engine, env: &Probe, id: ScriptId, quota: u64, expected: f64) -> r: Bool writes(engine), writes(env) {
  doc "Runs a compiled script to its end and checks that it returned the number expected.";
  let code = lp_run(engine: engine, env: env, id: id, quota: quota);
  if code != 0_u8 {
    return False();
  }
  return returned(engine: engine, expected: expected);
}

fn lp_compile_expect(engine: &Engine, env: &Probe, chunk: &[u8], source: &[u8], quota: u64, expected: f64) -> r: Bool reads(chunk), reads(source), writes(engine), writes(env) {
  let id = lp_id(engine: engine, chunk: chunk, source: source);
  return lp_expect(engine: engine, env: env, id: id, quota: quota, expected: expected);
}

fn lp_alone(chunk: &[u8], source: &[u8], quota: u64, expected: f64) -> r: Bool reads(chunk), reads(source) {
  doc "Runs source alone on a new engine, where every base is zero.";
  let engine = halo::embed::new_engine(limit: 67108864_u64);
  let env = Probe(mode: 0_u8, calls: 0_u64);
  return lp_compile_expect(engine: &engine, env: &env, chunk: chunk, source: source, quota: quota, expected: expected);
}

fn lp_keep(engine: &Engine, env: &Probe, chunk: &[u8], maker: &[u8], name: &[u8]) -> r: Bool reads(chunk), reads(maker), reads(name), writes(engine), writes(env) {
  doc "Runs a script that returns a function and keeps the function as the global called name.";
  let id = lp_id(engine: engine, chunk: chunk, source: maker);
  let code = lp_run(engine: engine, env: env, id: id, quota: 1000000_u64);
  if code != 0_u8 {
    return False();
  }
  match halo::embed::result(engine: engine, index: 0_u64) {
    None() => {
      return False();
    }
    Some(value: kept) => {
      let put = halo::embed::set_global(engine: engine, name: name, value: kept);
      return True();
    }
  }
}

fn lp_error_is(engine: &Engine, env: &Probe, chunk: &[u8], source: &[u8], want: &[u8]) -> r: Bool reads(chunk), reads(source), reads(want), writes(engine), writes(env) {
  doc "Runs source, which must end in an error, and checks the error text format_error gives.";
  let id = lp_id(engine: engine, chunk: chunk, source: source);
  let code = lp_run(engine: engine, env: env, id: id, quota: 1000000_u64);
  if code != 1_u8 {
    return False();
  }
  return format_matches(engine: engine, line: 0_u64, want: want);
}

