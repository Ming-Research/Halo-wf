fn lp_many() -> r: Bool pure {
  doc "Three hundred scripts compiled one after another, past every doubling of the tables that hold them, each run gives its own result.";
  let engine = halo::embed::new_engine(limit: 67108864_u64);
  let env = Probe(mode: 0_u8, calls: 0_u64);
  for (i in 0_u64..300_u64) {
    let kind = i % 3_u64;
    if kind == 0_u64 {
      let made = lp_id(engine: &engine, chunk: &probe_text_4[0_u64..12_u64], source: &lp_many0[0_u64..8_u64]);
    }
    if kind == 1_u64 {
      let made = lp_id(engine: &engine, chunk: &probe_text_4[0_u64..12_u64], source: &lp_many1[0_u64..26_u64]);
    }
    if kind == 2_u64 {
      let made = lp_id(engine: &engine, chunk: &probe_text_4[0_u64..12_u64], source: &lp_many2[0_u64..48_u64]);
    }
  }
  for (j in 0_u64..300_u64) {
    let k = 299_u64 - j;
    let generation = engine.generation;
    let id = ScriptId(slot: k, generation: generation);
    let kind_of = k % 3_u64;
    let number = kind_of + 1_u64;
    let want = cvt::<u64, f64>(number);
    let ok = lp_expect(engine: &engine, env: &env, id: id, quota: 1000000_u64, expected: want);
    if bnot(ok) {
      return False();
    }
  }
  return True();
}

fn lp_diag() -> r: u8 pure {
  doc "Diagnostic.";
  for (k in 0_u64..11_u64) {
    let want = cvt::<u64, f64>(k);
    let ok = lp_alone(chunk: &probe_text_4[0_u64..12_u64], source: &lp_src_bd[0_u64..1378_u64], quota: 1000000_u64, expected: want);
    if ok {
      let code = cvt.wrap::<u64, u8>(k);
      return 100_u8 + code;
    }
  }
  return 99_u8;
}

fn later_scripts_probe() -> r: u8 pure {
  doc "Scripts compiled after others, in one engine, run as they run alone. Each case gives its own code when it fails, the first failing one: 156 the expected values themselves, 157 scripts compiled after others, run in order and in reverse, 159 functions kept from later scripts, 160 flushes, 161 chunk names, 162 one safepoint at a time, 163 a coroutine of the last run, 164 string constants of scripts not running, 165 refused compiles, 166 three hundred scripts.";
  let diag_code = lp_diag();
  if diag_code != 0_u8 {
    return diag_code;
  }
  let alone_code = lp_alone_cases();
  if alone_code != 0_u8 {
    return alone_code;
  }
  let numeric_passed = lp_numeric();
  if bnot(numeric_passed) {
    return 157_u8;
  }
  let kept_passed = lp_kept_later();
  if bnot(kept_passed) {
    return 159_u8;
  }
  let flush_passed = lp_flushes();
  if bnot(flush_passed) {
    return 160_u8;
  }
  let chunks_passed = lp_chunks();
  if bnot(chunks_passed) {
    return 161_u8;
  }
  let slices_passed = lp_slices();
  if bnot(slices_passed) {
    return 162_u8;
  }
  let coroutine_passed = lp_coroutine();
  if bnot(coroutine_passed) {
    return 163_u8;
  }
  let literals_passed = lp_literals();
  if bnot(literals_passed) {
    return 164_u8;
  }
  let refused_passed = lp_refused();
  if bnot(refused_passed) {
    return 165_u8;
  }
  let many_passed = lp_many();
  if bnot(many_passed) {
    return 166_u8;
  }
  return 0_u8;
}

